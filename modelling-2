              ggplot2::ggtitle(bquote(italic(.(sp_disp)) ~ "(NET)")) +
              ggplot2::theme(plot.title = ggplot2::element_text(hjust = 0.5, size = 12), legend.position = "right")
            gg
          }, error = function(e) NULL)
          if (!is.null(p)) {
            ggsave(file.path(hypplot_cur, paste0(sp, "_hyp_net_", if(metric == "AUC_mean") "auc" else "tss", ".png")),
                   p, dpi = set_dpi, width = 12, height = 8)
          }
        }
        readr::write_tsv(h, file.path(hypplot_cur, paste0(sp, "_hyp_net.txt")))
      }
      
      if (!is.null(m_raf) && !is.null(m_raf$hyper_performance) && nrow(m_raf$hyper_performance) > 0) {
        h <- m_raf$hyper_performance
        for (metric in c("AUC_mean", "TSS_mean")) {
          p <- tryCatch({
            gg <- ggplot2::ggplot(h, ggplot2::aes_string(x = "mtry", y = metric)) +
              ggplot2::geom_line() + ggplot2::theme_bw() +
              ggplot2::ggtitle(bquote(italic(.(sp_disp)) ~ "(RAF)")) +
              ggplot2::theme(plot.title = ggplot2::element_text(hjust = 0.5, size = 12))
            gg
          }, error = function(e) NULL)
          if (!is.null(p)) {
            ggsave(file.path(hypplot_cur, paste0(sp, "_hyp_raf_", if(metric == "AUC_mean") "auc" else "tss", ".png")),
                   p, dpi = set_dpi, width = 10, height = 7)
          }
        }
        readr::write_tsv(h, file.path(hypplot_cur, paste0(sp, "_hyp_raf.txt")))
      }
      
      if (!is.null(m_svm) && !is.null(m_svm$hyper_performance) && nrow(m_svm$hyper_performance) > 0) {
        h <- m_svm$hyper_performance
        for (metric in c("AUC_mean", "TSS_mean")) {
          p <- tryCatch({
            gg <- ggplot2::ggplot(h, ggplot2::aes_string(x = "sigma", y = metric, col = "as.factor(C)")) +
              ggplot2::geom_line() + ggplot2::theme_bw() +
              ggplot2::ggtitle(bquote(italic(.(sp_disp)) ~ "(SVM)")) +
              ggplot2::theme(plot.title = ggplot2::element_text(hjust = 0.5, size = 12), legend.position = "right")
            gg
          }, error = function(e) NULL)
          if (!is.null(p)) {
            ggsave(file.path(hypplot_cur, paste0(sp, "_hyp_svm_", if(metric == "AUC_mean") "auc" else "tss", ".png")),
                   p, dpi = set_dpi, width = 12, height = 8)
          }
        }
        readr::write_tsv(h, file.path(hypplot_cur, paste0(sp, "_hyp_svm.txt")))
      }
      
      # ========== MODEL SELECTION ==========
      model_list_good <- list()
      if (!is.null(perf_summary)) {
        good_models <- perf_summary$model[!is.na(perf_summary$AUC_mean) & perf_summary$AUC_mean >= auc_thr]
        model_list_good <- model_list_nonnull[intersect(good_models, names(model_list_nonnull))]
        msg("Good models (AUC>=", auc_thr, "):", length(model_list_good))
      }
      
      # ========== BUILD ENSEMBLE ==========
      ensemble_list <- list()
      
      if (length(model_list_good) >= 2) {
        for (method in ens_method) {
          msg("Building ensemble:", method)
          ens_temp <- tryCatch(
            flexsdm::fit_ensemble(
              models = model_list_good, 
              ens_method = method,
              thr_model = "max_sens_spec", 
              metric = "TSS"
            ),
            error = function(e) NULL
          )
          if (!is.null(ens_temp)) {
            ensemble_list[[method]] <- ens_temp
            msg("  Success for:", method)
          } else {
            msg("  Failed for:", method)
          }
        }
        
        if (length(ensemble_list) > 0) {
          ens_perf_table <- tryCatch(
            flexsdm::sdm_summarize(ensemble_list),
            error = function(e) NULL
          )
          if (!is.null(ens_perf_table)) {
            readr::write_tsv(ens_perf_table, file.path(perf_dir, paste0(sp, "_ens_performance.txt")))
            msg("Ensembles built:", paste(names(ensemble_list), collapse=", "))
          }
        }
      } else if (length(model_list_good) == 1) {
        msg("Single model available, ensemble not created")
      } else {
        msg("No good models available for ensemble")
      }
      
      # ========== SAVE FITTED MODELS ==========
      save_file <- file.path(mod_out_dir, paste0(sp, "_fitted_models.RData"))
      if(!dir.exists(mod_out_dir)) dir.create(mod_out_dir, recursive = TRUE)
      tryCatch(save(model_list_nonnull, model_list_good, ensemble_list, perf_summary, file = save_file), error = function(e) NULL)
      
      # ========== MODELS FOR PREDICTION ==========
      models_for_pred <- if (length(model_list_good) > 0) model_list_good else model_list_nonnull
      
      if(length(models_for_pred) == 0) {
        pb$tick()
        next
      }
      
      # ========== CURRENT PROJECTIONS ==========
      msg("CURRENT projections...")
      
      alg_current_base <- file.path(out_pipeline_dir, "06_Algorithms", "01_Current")
      
      for (alg in names(models_for_pred)) {
        
        alg_threshold <- NA
        if(!is.null(perf_summary)) {
          thr_row <- perf_summary %>% dplyr::filter(model == alg, threshold == "max_sens_spec")
          if(nrow(thr_row) > 0) {
            alg_threshold <- thr_row$thr_value[1]
          }
        }
        
        pr_alg <- tryCatch(
          flexsdm::sdm_predict(
            models = list(models_for_pred[[alg]]),
            pred = env_r,
            thr = "max_sens_spec",
            con_thr = TRUE,
            clamp = TRUE,
            nchunk = n_chunk,
            pred_type = "cloglog"
          ),
          error = function(e) NULL
        )
        
        if (!is.null(pr_alg)) {
          con_r <- if (is.list(pr_alg)) pr_alg[[1]] else pr_alg
          bin_r <- if (is.list(pr_alg) && length(pr_alg) >= 2) pr_alg[[2]] else NULL
          
          if(is.null(bin_r) && !is.na(alg_threshold) && alg_threshold > 0 && alg_threshold < 1) {
            bin_r <- con_r >= alg_threshold
          }
          
          if(!is.null(bin_r)) {
            con_path <- file.path(alg_current_base, alg, "01_con", paste0(sp, ".tif"))
            bin_path <- file.path(alg_current_base, alg, "02_bin", paste0(sp, ".tif"))
            
            dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
            dir.create(dirname(bin_path), recursive = TRUE, showWarnings = FALSE)
            
            terra::writeRaster(con_r, con_path, overwrite = TRUE)
            terra::writeRaster(bin_r, bin_path, overwrite = TRUE)
            msg("  Saved", alg, "projections")
          }
        }
        gc()
      }
      
      # ========== CURRENT ENSEMBLE PREDICTIONS ==========
      if (length(ensemble_list) > 0) {
        msg("CURRENT ensemble predictions...")
        
        ens_current_base <- file.path(out_pipeline_dir, "07_Ensemble", "01_Current")
        
        for(method in names(ensemble_list)) {
          
          ens_threshold <- NA
          if(!is.null(ensemble_list[[method]]$performance)) {
            if(is.data.frame(ensemble_list[[method]]$performance) && nrow(ensemble_list[[method]]$performance) > 0) {
              thr_row <- ensemble_list[[method]]$performance %>% 
                dplyr::filter(threshold == "max_sens_spec")
              if(nrow(thr_row) > 0) {
                ens_threshold <- thr_row$thr_value[1]
              }
            }
          }
          
          if(is.na(ens_threshold)) {
            ens_threshold <- 0.5
          }
          
          ens_pred <- tryCatch(
            flexsdm::sdm_predict(
              models = ensemble_list[[method]],
              pred = env_r,
              thr = "max_sens_spec",
              con_thr = TRUE,
              clamp = TRUE,
              nchunk = n_chunk,
              pred_type = "cloglog"
            ),
            error = function(e) {
              msg("  Error predicting", method, ":", e$message)
              return(NULL)
            }
          )
          
          if(!is.null(ens_pred)) {
            con_r <- if (is.list(ens_pred)) ens_pred[[1]] else ens_pred
            bin_r <- if (is.list(ens_pred) && length(ens_pred) >= 2) ens_pred[[2]] else NULL
            
            if(is.null(bin_r) && !is.na(ens_threshold) && ens_threshold > 0 && ens_threshold < 1) {
              bin_r <- con_r >= ens_threshold
            }
            
            if(!is.null(con_r) && !is.null(bin_r)) {
              con_path <- file.path(ens_current_base, method, "01_con", paste0(sp, ".tif"))
              bin_path <- file.path(ens_current_base, method, "02_bin", paste0(sp, ".tif"))
              
              dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
              dir.create(dirname(bin_path), recursive = TRUE, showWarnings = FALSE)
              
              terra::writeRaster(con_r, con_path, overwrite = TRUE)
              terra::writeRaster(bin_r, bin_path, overwrite = TRUE)
              msg("  Saved ensemble", method, "projections")
            } else {
              msg("  Failed to create binary for", method)
            }
          } else {
            msg("  Prediction failed for", method)
          }
        }
      } else {
        msg("No valid ensemble available for current predictions")
      }
      
      # ========== PALEO PROJECTIONS ==========
      msg("PALEO projections...")
      
      alg_paleo_base <- file.path(out_pipeline_dir, "06_Algorithms", "02_Projection")
      pred_paleo_dir <- file.path(pred_dir, "02_Projection")
      
      if(dir.exists(pred_paleo_dir)) {
        for (p in paleo_names) {
          paleo_file <- file.path(pred_paleo_dir, p, paste0(sp, ".tif"))
          if (!file.exists(paleo_file)) next
          
          env_pal <- terra::rast(paleo_file)
          
          for (alg in names(models_for_pred)) {
            alg_threshold <- NA
            if(!is.null(perf_summary)) {
              thr_row <- perf_summary %>% dplyr::filter(model == alg, threshold == "max_sens_spec")
