cleanup_after_species <- function() {
  # Only clean terra's internal temp files
  # DO NOT delete the main temp directory
  # DO NOT close all connections
  tryCatch({
    terra::tmpFiles(remove = TRUE, old = TRUE)
  }, error = function(e) {})
  
  # Single garbage collection (not multiple)
  gc(verbose = FALSE)
  
  # Small delay for OS to release handles
  Sys.sleep(0.1)
}

