# ============================================================================
# SECTION 7: MAIN SDM PIPELINE
# ============================================================================

for(pipeline in pipelines) {
  
  msg("\n")
  prt_sub(paste("STARTING PIPELINE:", pipeline))
  msg("")
  
  if(pipeline == "01_Without_MD") {
    pred_dir <- without_md_pred_dir
    occ_dir <- without_md_occ_dir
    msg("Using: Without MD predictors")
  } else if(pipeline == "02_With_MD") {
    pred_dir <- with_md_pred_dir
    occ_dir <- with_md_occ_dir
    msg("Using: With MD predictors")
  } else {
    msg("ERROR: Unknown pipeline - skipping")
    next
  }
  
  out_pipeline_dir <- file.path(base_sdm, pipeline)
  
  perf_dir <- file.path(out_pipeline_dir, "02_Model_perform")
  mod_out_dir <- file.path(out_pipeline_dir, "01_Model_fitted")
  hypplot_cur <- file.path(out_pipeline_dir, "04_Hyper_plot")
  pdp_plots_dir <- file.path(out_pipeline_dir, "03_PDP_Plot")
  uncertainty_dir <- file.path(out_pipeline_dir, "05_Uncertainty")
  
  occ_file <- file.path(occ_dir, "1_occ_presabs_partitioned.gz")
  bkg_file <- file.path(occ_dir, "1_occ_bkgroud_partitioned.gz")
  
  if(!file.exists(occ_file)) {
    msg("ERROR: Missing file:", occ_file)
    msg("Skipping pipeline:", pipeline)
    next
  }
  
  if(!file.exists(bkg_file)) {
    msg("ERROR: Missing file:", bkg_file)
    msg("Skipping pipeline:", pipeline)
    next
  }
  
  occ <- data.table::fread(occ_file) %>% tibble::as_tibble()
  bkg <- data.table::fread(bkg_file) %>% tibble::as_tibble()
  
  if (!(".part" %in% names(occ))) {
    set.seed(42)
    n <- max(1, length(unique(na.omit(occ$.part))))
    occ$.part <- sample(rep(seq_len(n), length.out = nrow(occ)))
  }
  
  pred_current_dir <- file.path(pred_dir, "01_Current")
  if(!dir.exists(pred_current_dir)) {
    msg("ERROR: Missing directory:", pred_current_dir)
    msg("Skipping pipeline:", pipeline)
    next
  }
  
  pred_files <- list.files(pred_current_dir, pattern = "\\.tif$", full.names = TRUE)
  
  if(length(pred_files) == 0) {
    msg("ERROR: No .tif files found in:", pred_current_dir)
    msg("Skipping pipeline:", pipeline)
    next
  }
  
  sp_names <- gsub("\\.tif$", "", basename(pred_files))
  sp_final <- intersect(unique(occ$species), sp_names)
  
  if(sp_select[1] == "ALL") {
    sp_ready <- sp_final
  } else {
    sp_ready <- sp_final[sp_select]
  }
  
  msg("Pipeline:", sub("^\\d+_", "", pipeline))
  msg("Species available:", length(sp_final))
  msg("Species to process:", length(sp_ready))
  msg("")
  
  if(length(sp_ready) == 0) {
    msg("WARNING: No species to process for pipeline:", pipeline)
    next
  }
  
  pb <- progress::progress_bar$new(
    total = length(sp_ready),
    format = "[:bar] :current/:total (:percent) | :elapsed | :eta",
    width = 60
  )
  
  # ======================================
  # SPECIES LOOP - CORRECTED (NO DANGEROUS OPERATIONS)
  # ======================================
  for (i in seq_along(sp_ready)) {
    
    # REMOVED: cleanup_after_species() and prepare_parallel() calls
    # REMOVED: species_temp_dir creation
    # REMOVED: terra::terraOptions(tempdir = ...) reassignment
    
    sp <- sp_ready[i]
    sp_disp <- gsub("_", " ", sp)
    
    set.seed(123 + i)
    
    header <- crt_hed(sp, i, length(sp_ready))
    prt_hed(header)
    
    tryCatch({
      
      cur_env_file <- file.path(pred_current_dir, paste0(sp, ".tif"))
      if (!file.exists(cur_env_file)) {
        msg("WARNING: Missing environmental file for:", sp)
        pb$tick()
        next
      }
      
      env_r <- terra::rast(cur_env_file)
      var_names <- names(env_r)
      n_pred <- length(var_names)
      
      pa_pr <- dplyr::filter(occ, species == sp)
      pa_bg <- dplyr::filter(bkg, species == sp)
      
      if (nrow(pa_pr) == 0) {
        msg("WARNING: No presence records for:", sp)
        pb$tick()
        next
      }
      
      part_cols <- grep("^\\.part", names(pa_pr), value = TRUE)
      pa <- dplyr::bind_rows(pa_pr, pa_bg) %>%
        dplyr::select(dplyr::any_of(c("x", "y", "pr_ab", "species", part_cols)))
      b <- dplyr::select(pa_bg, dplyr::any_of(c("x", "y", "pr_ab", "species", part_cols)))
      
      pa <- tryCatch(flexsdm::sdm_extract(pa, x = "x", y = "y", env_layer = env_r), error = function(e) NULL)
      b <- tryCatch(flexsdm::sdm_extract(b, x = "x", y = "y", env_layer = env_r), error = function(e) NULL)
      
      if (is.null(pa) || is.null(b)) {
        pb$tick()
        next
      }
      
      pa <- tidyr::drop_na(pa)
      b <- tidyr::drop_na(b)
      
      n_pres <- nrow(dplyr::filter(pa, pr_ab == 1))
      
      if (n_pres < 5) {
        msg("WARNING: Too few presences for:", sp, "-", n_pres)
        pb$tick()
        next
      }
      
      msg("Predictors:", length(var_names))
      msg("Training records =", n_pres)
      
      # GLM
      msg("GLM Fitting...")
      if (n_pres >= 100) {
        m_glm <- tryCatch(
          flexsdm::fit_glm(data = pa, response = "pr_ab", predictors = var_names,
                           partition = ".part", thr = "max_sens_spec", poly = 2),
          error = function(e) NULL
        )
      } else { m_glm <- NULL }
      
      # GAM
      msg("GAM Fitting...")
      if (n_pres >= 50) {
        n_training <- tryCatch(flexsdm:::n_training(data = pa, partition = ".part"), error = function(e) min(n_pres, 50))
        candidate_k <- 20
        while (any(n_training < (candidate_k * 4)) && candidate_k > 3) candidate_k <- candidate_k - 1
        candidate_k <- max(3, candidate_k)
        m_gam <- tryCatch(
          flexsdm::fit_gam(data = pa, response = "pr_ab", predictors = var_names,
                           partition = ".part", thr = "max_sens_spec", k = candidate_k),
          error = function(e) NULL
        )
      } else { m_gam <- NULL }
      
      # GAU
      msg("GAU Fitting...")
      if (n_pres >= 15) {
        m_gau <- tryCatch(
          flexsdm::fit_gau(data = pa, response = "pr_ab", predictors = var_names,
                           partition = ".part", background = b, thr = "max_sens_spec"),
          error = function(e) NULL
        )
      } else { m_gau <- NULL }
      
      # GBM - REMOVED prepare_parallel() and cleanup calls
      msg("GBM Fitting...")
      set.seed(123)
      m_gbm <- tryCatch(
        flexsdm::tune_gbm(data = pa, response = "pr_ab", predictors = var_names,
                          partition = ".part", grid = grid_gbm, thr = "max_sens_spec", 
                          metric = "TSS", n_cores = n_cores),
        error = function(e) NULL
      )
      
      # MAX - REMOVED prepare_parallel() and cleanup calls
      msg("MAX Fitting...")
      set.seed(123)
      m_max <- tryCatch(
        flexsdm::tune_max(data = pa, response = "pr_ab", predictors = var_names,
                          partition = ".part", background = b, grid = grid_max,
                          thr = "max_sens_spec", metric = "TSS", n_cores = n_cores),
        error = function(e) NULL
      )
      
      # NET - REMOVED prepare_parallel() and cleanup calls
      msg("NET Fitting...")
      set.seed(123)
      grid_net_dyn <- grid_net[grid_net$size <= min(n_pred, 10), ]
      m_net <- tryCatch(
        flexsdm::tune_net(data = pa, response = "pr_ab", predictors = var_names,
                          partition = ".part", grid = grid_net_dyn, thr = "max_sens_spec", 
                          metric = "TSS", n_cores = n_cores),
        error = function(e) NULL
      )
      
      # RAF - REMOVED prepare_parallel() and cleanup calls
      msg("RAF Fitting...")
      set.seed(123)
      grid_raf_dyn <- grid_raf[grid_raf$mtry <= min(n_pred, 10), ]
      m_raf <- tryCatch(
        flexsdm::tune_raf(data = pa, response = "pr_ab", predictors = var_names,
                          partition = ".part", grid = grid_raf_dyn, thr = "max_sens_spec", 
                          metric = "TSS", n_cores = n_cores),
        error = function(e) NULL
      )
      
      # SVM - REMOVED prepare_parallel() and cleanup calls
      msg("SVM Fitting...")
      set.seed(123)
      m_svm <- tryCatch(
        flexsdm::tune_svm(data = pa, response = "pr_ab", predictors = var_names,
                          partition = ".part", grid = grid_svm, thr = "max_sens_spec", 
                          metric = "TSS", n_cores = n_cores),
        error = function(e) NULL
      )
      
      model_list_all <- list(glm = m_glm, gam = m_gam, gau = m_gau, gbm = m_gbm,
                             max = m_max, net = m_net, raf = m_raf, svm = m_svm)
      model_list_nonnull <- model_list_all[!vapply(model_list_all, is.null, logical(1))]
      msg()
      msg("Models fitted:", length(model_list_nonnull), "of 8")
      
      # Fix missing thresholds
      for(alg in names(model_list_nonnull)) {
        if(is.null(model_list_nonnull[[alg]]$threshold) || is.na(model_list_nonnull[[alg]]$threshold)) {
          perf <- tryCatch(flexsdm::sdm_summarize(list(model_list_nonnull[[alg]])), error = function(e) NULL)
          if(!is.null(perf) && !is.na(perf$thr_value[1])) {
            model_list_nonnull[[alg]]$threshold <- perf$thr_value[1]
          }
        }
      }
      
      # Performance evaluation
      perf_summary <- NULL
      if (length(model_list_nonnull) > 0) {
        perf_summary <- tryCatch(suppressWarnings(flexsdm::sdm_summarize(model_list_nonnull)), error = function(e) NULL)
        if (!is.null(perf_summary)) {
          perf_file <- file.path(perf_dir, paste0(sp, "_performance.txt"))
          if(!dir.exists(perf_dir)) dir.create(perf_dir, recursive = TRUE, showWarnings = FALSE)
          readr::write_tsv(perf_summary, perf_file)
          msg("Performance saved")
        }
      }
      
      # Variable importance
      if (length(var_names) > 0 && length(model_list_nonnull) > 0) {
        pred_sds <- sapply(pa[, intersect(var_names, names(pa)), drop = FALSE],
                           function(x) if (is.numeric(x)) stats::sd(x, na.rm = TRUE) else NA_real_)
        good_preds <- names(pred_sds)[!is.na(pred_sds) & pred_sds > 0]
        
        if (length(good_preds) > 0) {
          varimp_out <- list()
          for (alg in names(model_list_nonnull)) {
            v_res <- tryCatch(
              flexsdm::sdm_varimp(models = list(model_list_nonnull[[alg]]), data = pa,
                                  response = "pr_ab", predictors = good_preds,
                                  n_sim = n_sim, n_cores = n_cores, thr = "max_sens_spec", clamp = TRUE),
              error = function(e) NULL
            )
            if (!is.null(v_res)) {
              vdf <- if (is.data.frame(v_res)) v_res else if (is.list(v_res)) as.data.frame(v_res) else NULL
              if (!is.null(vdf)) {
                if (!("variable" %in% names(vdf))) vdf <- tibble::rownames_to_column(vdf, var = "variable")
                num_cols <- names(vdf)[sapply(vdf, is.numeric) & names(vdf) != "variable"]
                if (length(num_cols) > 0) {
                  varimp_out[[alg]] <- tibble::tibble(
                    variable = as.character(vdf$variable),
                    importance_mean = as.numeric(rowMeans(vdf[, num_cols, drop = FALSE], na.rm = TRUE)),
                    importance_median = as.numeric(apply(vdf[, num_cols, drop = FALSE], 1, median, na.rm = TRUE)),
                    importance_sd = as.numeric(apply(vdf[, num_cols, drop = FALSE], 1, sd, na.rm = TRUE)),
                    model = alg
                  )
                }
              }
            }
            gc()
          }
          if (length(varimp_out) > 0) {
            varimp_file <- file.path(perf_dir, paste0(sp, "_varimp.txt"))
            readr::write_delim(dplyr::bind_rows(varimp_out), varimp_file, delim = "\t")
          }
        }
      }
      
      # ========== UNCERTAINTY ANALYSIS ==========
      successful_models <- model_list_nonnull[!sapply(model_list_nonnull, is.null)]
      
      if(length(successful_models) >= 2) {
        msg("Running uncertainty analysis...")
        uncertainty_rasters <- list()
        
        for(alg_name in names(successful_models)) {
          msg("  Processing", alg_name, "...")
          unc_result <- tryCatch({
            flexsdm::sdm_uncertainty(
              models = successful_models[[alg_name]],
              training_data = pa,
              response = "pr_ab",
              projection_data = env_r,
              iteration = u_itr,
              n_cores = n_cores,
              clamp = TRUE,
              pred_type = "cloglog"
            )
          }, error = function(e) {
            msg("    Error:", e$message)
            return(NULL)
          })
          
          if(!is.null(unc_result)) {
            uncertainty_rasters[[alg_name]] <- unc_result
            msg("    Completed")
          }
          gc()
        }
        
        if(length(uncertainty_rasters) >= 2) {
          unc_stack <- terra::rast(uncertainty_rasters)
          
          mean_unc <- terra::app(unc_stack, fun = mean, na.rm = TRUE)
          median_unc <- terra::app(unc_stack, fun = median, na.rm = TRUE)
          
          terra::writeRaster(mean_unc, file.path(uncertainty_dir, "03_Raster", paste0(sp, "_mean_uncertainty.tif")), 
                             overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
          terra::writeRaster(median_unc, file.path(uncertainty_dir, "03_Raster", paste0(sp, "_median_uncertainty.tif")), 
                             overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
          
          results <- data.frame(Model = character(), Uncertainty_Mean = numeric(), 
                                stringsAsFactors = FALSE)
          for(nm in names(uncertainty_rasters)) {
            vals <- terra::values(uncertainty_rasters[[nm]], na.rm = TRUE)
            results <- rbind(results, data.frame(Model = nm, 
                                                 Uncertainty_Mean = mean(vals, na.rm = TRUE)))
          }
          write.csv(results, file.path(uncertainty_dir, "02_Summary", paste0(sp, "_individual_uncertainty.csv")), row.names = FALSE)
          
          names(mean_unc) <- "uncertainty"
          p1 <- ggplot() + tidyterra::geom_spatraster(data = mean_unc) +
            scale_fill_viridis_c(name = "Uncertainty", direction = 1, option = "inferno", na.value = "transparent") +
            theme_bw() + labs(title = bquote(italic(.(sp_disp)) ~ "- Mean Uncertainty")) +
            theme(plot.title = element_text(hjust = 0.5))
          ggsave(file.path(uncertainty_dir, "01_Plots", paste0(sp, "_mean_uncertainty_map.png")), p1, dpi = set_dpi, width = 10, height = 8)
          
          names(median_unc) <- "uncertainty"
          p2 <- ggplot() + tidyterra::geom_spatraster(data = median_unc) +
            scale_fill_viridis_c(name = "Uncertainty", direction = 1, option = "plasma", na.value = "transparent") +
            theme_bw() + labs(title = bquote(italic(.(sp_disp)) ~ "- Median Uncertainty")) +
            theme(plot.title = element_text(hjust = 0.5))
          ggsave(file.path(uncertainty_dir, "01_Plots", paste0(sp, "_median_uncertainty_map.png")), p2, dpi = set_dpi, width = 10, height = 8)
          
          msg("Uncertainty analysis completed")
        }
      } else {
        msg("Not enough models for uncertainty analysis (need at least 2)")
      }
      gc()
      
      # ========== PDP PLOTS ==========
      msg("Generating PDP plots...")
      
      if (length(successful_models) >= 2) {
        pdp_list <- list()
        for(model_name in names(successful_models)) {
          pdp_results <- list()
          
          model_obj <- successful_models[[model_name]]
          if(inherits(model_obj, "train")) {
            model <- model_obj
          } else if(inherits(model_obj, "sdm_model") && !is.null(model_obj$model)) {
            model <- model_obj$model
          } else {
            model <- model_obj
          }
          
          for(p in var_names) {
            tryCatch({
              if(!is.null(model)) {
                pdp_output <- flexsdm::data_pdp(model = model, predictors = p, resolution = pdp_res,
                                                resid = TRUE, projection_data = env_r,
                                                training_data = pa, clamping = FALSE)
                if(!is.null(pdp_output) && !is.null(pdp_output$pdpdata)) {
                  df <- pdp_output$pdpdata
                  df$Predictor <- p
                  df$Value <- df[[p]]
                  df[[p]] <- NULL
                  df$Algorithm <- model_name
                  pdp_results[[p]] <- df
                }
              }
            }, error = function(e) {})
          }
          pdp_results <- pdp_results[!sapply(pdp_results, is.null)]
          if(length(pdp_results) > 0) pdp_list[[model_name]] <- dplyr::bind_rows(pdp_results)
          gc()
        }
        
        if(length(pdp_list) > 0) {
          db_all <- dplyr::bind_rows(pdp_list)
          db_wide <- db_all %>% dplyr::select(Predictor, Value, Algorithm, Suitability) %>%
            tidyr::pivot_wider(names_from = Algorithm, values_from = Suitability)
          algo_cols <- names(db_wide)[names(db_wide) %in% names(successful_models)]
          
          if(length(algo_cols) > 0) {
            db_wide <- db_wide %>% dplyr::mutate(
              Ensemble_Mean = rowMeans(dplyr::select(., dplyr::all_of(algo_cols)), na.rm = TRUE),
              Ensemble_Median = apply(dplyr::select(., dplyr::all_of(algo_cols)), 1, median, na.rm = TRUE),
              SD = apply(dplyr::select(., dplyr::all_of(algo_cols)), 1, sd, na.rm = TRUE),
              ymin = pmax(0, Ensemble_Mean - SD), ymax = pmin(1, Ensemble_Mean + SD)
            )
            
            db_long_mean <- db_wide %>% tidyr::pivot_longer(cols = dplyr::all_of(c(algo_cols, "Ensemble_Mean")),
                                                            names_to = "Algorithm", values_to = "Suitability")
            db_median <- db_wide %>% dplyr::select(Predictor, Value, Ensemble_Median) %>%
              dplyr::mutate(Algorithm = "Ensemble_Median")
            
            n_models <- length(algo_cols)
            color_values <- c(setNames(grDevices::rainbow(n_models), algo_cols),
                              Ensemble_Mean = "black", Ensemble_Median = "steelblue")
            linetype_values <- c(setNames(rep("dotted", n_models), algo_cols),
                                 Ensemble_Mean = "solid", Ensemble_Median = "dashed")
            
            pdp_plot <- ggplot() +
              geom_ribbon(data = db_wide, aes(x = Value, ymin = ymin, ymax = ymax), fill = "grey70", alpha = 0.4) +
              geom_line(data = db_long_mean %>% dplyr::filter(Algorithm != "Ensemble_Mean"),
                        aes(x = Value, y = Suitability, color = Algorithm, linetype = Algorithm), linewidth = 0.8, alpha = 0.7) +
              geom_line(data = db_long_mean %>% dplyr::filter(Algorithm == "Ensemble_Mean"),
                        aes(x = Value, y = Suitability), color = "black", linewidth = 1.2, linetype = "solid") +
              geom_line(data = db_median, aes(x = Value, y = Ensemble_Median), color = "blue", linewidth = 1.2, linetype = "dashed") +
              facet_wrap(~Predictor, scales = "free_x", ncol = 2) + coord_cartesian(ylim = c(0, 1)) +
              scale_linetype_manual(values = linetype_values) + scale_color_manual(values = color_values) +
              labs(title = bquote(italic(.(sp_disp)) ~ "- Partial Dependency Plot"),
                   subtitle = paste("Based on", length(successful_models), "models"),
                   x = "Environmental Gradient", y = "Suitability") +
              theme_bw() + theme(panel.grid = element_blank(), legend.position = "right",
                                 plot.title = element_text(hjust = 0.5, size = 14),
                                 plot.subtitle = element_text(hjust = 0.5, size = 11))
            
            if(!dir.exists(pdp_plots_dir)) dir.create(pdp_plots_dir, recursive = TRUE)
            ggsave(file.path(pdp_plots_dir, paste0(sp, "_pdp_ensemble.png")), pdp_plot, width = 28, height = 20, units = "cm", dpi = set_dpi)
            write.csv(db_wide, file.path(pdp_plots_dir, paste0(sp, "_pdp_data.csv")), row.names = FALSE)
          }
        }
      } else {
        for (alg in names(successful_models)) {
          model_obj <- successful_models[[alg]]
          if(inherits(model_obj, "train")) {
            model <- model_obj
          } else if(inherits(model_obj, "sdm_model") && !is.null(model_obj$model)) {
            model <- model_obj$model
          } else {
            model <- model_obj
          }
          if(!is.null(model)) {
            tryCatch({
              p_pdp <- flexsdm::data_pdp(model = model, predictors = var_names,
                                         resolution = pdp_res, resid = TRUE,
                                         projection_data = env_r, training_data = pa, clamping = FALSE)
              if(!is.null(p_pdp) && !is.null(p_pdp$pdpdata)) {
                p <- ggplot(p_pdp$pdpdata, aes(x = .data[[var_names[1]]], y = Suitability)) +
