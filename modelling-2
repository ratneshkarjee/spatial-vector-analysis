                dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
                dir.create(dirname(bin_path), recursive = TRUE, showWarnings = FALSE)
                
                terra::writeRaster(con_r, con_path, overwrite = TRUE)
                terra::writeRaster(bin_r, bin_path, overwrite = TRUE)
              }
            }
            gc()
          }
          
          if (length(ensemble_list) > 0) {
            ens_paleo_base <- file.path(out_pipeline_dir, "07_Ensemble", "02_Projection", p)
            
            for(method in names(ensemble_list)) {
              
              ens_threshold <- NA
              if(!is.null(ensemble_list[[method]]$performance)) {
                if(is.data.frame(ensemble_list[[method]]$performance) && nrow(ensemble_list[[method]]$performance) > 0) {
                  thr_row <- ensemble_list[[method]]$performance %>% 
                    dplyr::filter(threshold == "max_sens_spec")
                  if(nrow(thr_row) > 0) {
                    ens_threshold <- thr_row$thr_value[1]
                  }
                }
              }
              
              if(is.na(ens_threshold)) ens_threshold <- 0.5
              
              ens_pred <- tryCatch(
                flexsdm::sdm_predict(
                  models = ensemble_list[[method]],
                  pred = env_pal,
                  thr = "max_sens_spec",
                  con_thr = TRUE,
                  clamp = TRUE,
                  nchunk = n_chunk,
                  pred_type = "cloglog"
                ),
                error = function(e) NULL
              )
              
              if(!is.null(ens_pred)) {
                con_r <- if (is.list(ens_pred)) ens_pred[[1]] else ens_pred
                bin_r <- if (is.list(ens_pred) && length(ens_pred) >= 2) ens_pred[[2]] else NULL
                
                if(is.null(bin_r) && !is.na(ens_threshold) && ens_threshold > 0 && ens_threshold < 1) {
                  bin_r <- con_r >= ens_threshold
                }
                
                if(!is.null(con_r) && !is.null(bin_r)) {
                  con_path <- file.path(ens_paleo_base, method, "01_con", paste0(sp, ".tif"))
                  bin_path <- file.path(ens_paleo_base, method, "02_bin", paste0(sp, ".tif"))
                  
                  dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
                  dir.create(dirname(bin_path), recursive = TRUE, showWarnings = FALSE)
                  
                  terra::writeRaster(con_r, con_path, overwrite = TRUE)
                  terra::writeRaster(bin_r, bin_path, overwrite = TRUE)
                }
              }
            }
          }
        }
      } else {
        msg("No paleo projections directory found")
      }
      
      # ========== FUTURE PROJECTIONS ==========
      msg("FUTURE projections...")
      
      alg_future_base <- file.path(out_pipeline_dir, "06_Algorithms", "03_Projection")
      pred_future_dir <- file.path(pred_dir, "03_Projection")
      
      if(dir.exists(pred_future_dir)) {
        for (f in future_names) {
          future_file <- file.path(pred_future_dir, f, paste0(sp, ".tif"))
          if (!file.exists(future_file)) next
          
          env_fut <- terra::rast(future_file)
          
          for (alg in names(models_for_pred)) {
            alg_threshold <- NA
            if(!is.null(perf_summary)) {
              thr_row <- perf_summary %>% dplyr::filter(model == alg, threshold == "max_sens_spec")
              if(nrow(thr_row) > 0) {
                alg_threshold <- thr_row$thr_value[1]
              }
            }
            
            pr_alg <- tryCatch(
              flexsdm::sdm_predict(
                models = list(models_for_pred[[alg]]),
                pred = env_fut,
                thr = "max_sens_spec",
                con_thr = TRUE,
                clamp = TRUE,
                nchunk = n_chunk,
                pred_type = "cloglog"
              ),
              error = function(e) NULL
            )
            
            if (!is.null(pr_alg)) {
              con_r <- if (is.list(pr_alg)) pr_alg[[1]] else pr_alg
              bin_r <- if (is.list(pr_alg) && length(pr_alg) >= 2) pr_alg[[2]] else NULL
              
              if(is.null(bin_r) && !is.na(alg_threshold) && alg_threshold > 0 && alg_threshold < 1) {
                bin_r <- con_r >= alg_threshold
              }
              
              if(!is.null(bin_r)) {
                con_path <- file.path(alg_future_base, f, alg, "01_con", paste0(sp, ".tif"))
                bin_path <- file.path(alg_future_base, f, alg, "02_bin", paste0(sp, ".tif"))
                
                dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
                dir.create(dirname(bin_path), recursive = TRUE, showWarnings = FALSE)
                
                terra::writeRaster(con_r, con_path, overwrite = TRUE)
                terra::writeRaster(bin_r, bin_path, overwrite = TRUE)
              }
            }
            gc()
          }
          
          if (length(ensemble_list) > 0) {
            ens_future_base <- file.path(out_pipeline_dir, "07_Ensemble", "03_Projection", f)
            
            for(method in names(ensemble_list)) {
              
              ens_threshold <- NA
              if(!is.null(ensemble_list[[method]]$performance)) {
                if(is.data.frame(ensemble_list[[method]]$performance) && nrow(ensemble_list[[method]]$performance) > 0) {
                  thr_row <- ensemble_list[[method]]$performance %>% 
                    dplyr::filter(threshold == "max_sens_spec")
                  if(nrow(thr_row) > 0) {
                    ens_threshold <- thr_row$thr_value[1]
                  }
                }
              }
              
              if(is.na(ens_threshold)) ens_threshold <- 0.5
              
              ens_pred <- tryCatch(
                flexsdm::sdm_predict(
                  models = ensemble_list[[method]],
                  pred = env_fut,
                  thr = "max_sens_spec",
                  con_thr = TRUE,
                  clamp = TRUE,
                  nchunk = n_chunk,
                  pred_type = "cloglog"
                ),
                error = function(e) NULL
              )
              
              if(!is.null(ens_pred)) {
                con_r <- if (is.list(ens_pred)) ens_pred[[1]] else ens_pred
                bin_r <- if (is.list(ens_pred) && length(ens_pred) >= 2) ens_pred[[2]] else NULL
                
                if(is.null(bin_r) && !is.na(ens_threshold) && ens_threshold > 0 && ens_threshold < 1) {
                  bin_r <- con_r >= ens_threshold
                }
                
                if(!is.null(con_r) && !is.null(bin_r)) {
                  con_path <- file.path(ens_future_base, method, "01_con", paste0(sp, ".tif"))
                  bin_path <- file.path(ens_future_base, method, "02_bin", paste0(sp, ".tif"))
                  
                  dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
                  dir.create(dirname(bin_path), recursive = TRUE, showWarnings = FALSE)
                  
                  terra::writeRaster(con_r, con_path, overwrite = TRUE)
                  terra::writeRaster(bin_r, bin_path, overwrite = TRUE)
                  msg("  Saved future ensemble", method, "for", f)
                }
              }
            }
          }
        }
      } else {
        msg("No future projections directory found")
      }
      
      msg("")
      
      # Clean up for this species (MINIMAL - no directory deletion)
      rm(list = grep("^m_", ls(), value = TRUE), envir = environment())
      if (exists("env_r")) rm(env_r, envir = environment())
      if (exists("env_pal")) rm(env_pal, envir = environment())
      if (exists("env_fut")) rm(env_fut, envir = environment())
      
      # Only clean terra temp files, NOT the directory
      terra::tmpFiles(remove = TRUE, old = TRUE)
      gc(verbose = FALSE)
      
    }, error = function(e) {
      msg("ERROR:", e$message)
      msg("")
    })
    
    pb$tick()
  }
  
  msg("SDM workflow completed for", pipeline)
  msg("")
}

