                clamp = TRUE,
                nchunk = n_chunk,
                pred_type = "cloglog"
              ),
              error = function(e) NULL
            )
            
            if (!is.null(pr_alg)) {
              con_r <- if (is.list(pr_alg)) pr_alg[[1]] else pr_alg
              bin_r <- if (is.list(pr_alg) && length(pr_alg) >= 2) pr_alg[[2]] else NULL
              
              if(is.null(bin_r) && !is.na(alg_threshold) && alg_threshold > 0 && alg_threshold < 1) {
                bin_r <- con_r >= alg_threshold
              }
              
              if(!is.null(bin_r)) {
                con_path <- file.path(alg_paleo_base, p, alg, "01_con", paste0(sp, ".tif"))
