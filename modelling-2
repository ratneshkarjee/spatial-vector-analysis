                  labs(title = bquote(italic(.(sp_disp)) ~ "-" ~ .(toupper(alg))),
                       x = var_names[1], y = "Suitability") + theme(plot.title = element_text(hjust = 0.5))
                ggsave(file.path(pdp_plots_dir, paste0(sp, "_", alg, "_pdp.png")), p, width = 20, height = 15, units = "cm", dpi = set_dpi)
              }
            }, error = function(e) {})
          }
          gc()
        }
      }
      
      # ========== HYPERPARAMETER PLOTS ==========
      msg("Hyperparameter plots...")
      
      if (!is.null(m_gbm) && !is.null(m_gbm$hyper_performance) && nrow(m_gbm$hyper_performance) > 0) {
        h <- m_gbm$hyper_performance
        for (metric in c("AUC_mean", "TSS_mean")) {
          p <- tryCatch({
            gg <- ggplot2::ggplot(h, ggplot2::aes_string(x = "n.trees", y = metric, col = "as.factor(n.minobsinnode)")) +
