# Safe graphics device closure
safe_ggsave <- function(filename, plot, width = 10, height = 8, dpi = 500) {
  tryCatch({
    ggplot2::ggsave(
      filename = filename, plot = plot,
      width = width, height = height, dpi = dpi, bg = "white"
    )
    grDevices::dev.off()  # CRITICAL: Close device
    invisible(TRUE)
  }, error = function(e) {
    tryCatch(grDevices::dev.off(), error = function(e2) invisible(NULL))
    msg("  [WARNING] ggsave failed for", basename(filename), ":", e$message)
    invisible(FALSE)
  })
}

# Explicit raster closure
close_raster <- function(r, name = "") {
  if (!is.null(r)) {
    tryCatch({
      if (inherits(r, "SpatRaster")) terra::close(r)
      if (name != "") rm(list = name, envir = parent.frame(2), inherits = FALSE)
    }, error = function(e) invisible(NULL))
  }
  invisible(NULL)
}

# Safe terra::app wrapper (prevents temp layer explosion on large stacks)
terra_app_chunked <- function(stack_r, fun, na.rm = TRUE, chunk_size = 5) {
  tryCatch({
    n_layers <- terra::nlyr(stack_r)
    
    if (n_layers > chunk_size) {
      # Process in chunks to avoid temp layer accumulation
      chunk_results <- list()
      for (i in seq(1, n_layers, chunk_size)) {
        end_idx <- min(i + chunk_size - 1, n_layers)
        chunk <- stack_r[[i:end_idx]]
        chunk_result <- terra::app(chunk, fun = fun, na.rm = na.rm)
        chunk_results[[length(chunk_results) + 1]] <- chunk_result
        terra::close(chunk)
        rm(chunk_result)
      }
      
      if (length(chunk_results) > 1) {
        all_results <- terra::rast(chunk_results)
        final_result <- terra::app(all_results, fun = mean, na.rm = na.rm)
        terra::close(all_results)
        for (r in chunk_results) terra::close(r)
        return(final_result)
      }
    }
    
    return(terra::app(stack_r, fun = fun, na.rm = na.rm))
  }, error = function(e) {
    msg("[ERROR] terra_app_chunked failed:", e$message)
    return(NULL)
  })
}

# Cleanup between species
cleanup_species <- function() {
  terra::tmpFiles(remove = TRUE, old = TRUE)
  gc(verbose = FALSE, reset = TRUE)
  Sys.sleep(0.1)  # Allow OS to release file handles
}

