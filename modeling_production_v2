# ============================================================================
# SECTION 5: MAIN SPECIES LOOP (SEQUENTIAL, PER-SPECIES RASTER MANAGEMENT)
# ============================================================================

msg(">>> MAIN PROCESSING LOOP <<<\n")

pb <- progress::progress_bar$new(
  total = length(sp_available),
  format = "[:bar] :current/:total | :percent | :eta",
  width = 60
)

for (i in seq_along(sp_available)) {
  
  sp <- sp_available[i]
  sp_display <- gsub("_", " ", sp)
  set.seed(123 + i)
  
  header <- paste0("SPECIES: ", sp_display, " [", i, "/", length(sp_available), "]")
  msg("\n", strrep("=", nchar(header)))
  msg(header)
  msg(strrep("=", nchar(header)))
  
  tryCatch({
    
    # ========== LOAD CURRENT ENVIRONMENT (PER-SPECIES) ==========
    cur_env_file <- file.path(env_cur_dir, paste0(sp, ".tif"))
    if (!file.exists(cur_env_file)) {
      msg("  [SKIP] No current PCA file")
      pb$tick()
      next
    }
    
    env_r <- tryCatch(terra::rast(cur_env_file), error = function(e) NULL)
    if (is.null(env_r)) {
      msg("  [SKIP] Cannot load current PCA")
      pb$tick()
      next
    }
    
    var_names <- names(env_r)
    n_pred <- length(var_names)
    msg("Predictors:", n_pred)
    
    # ========== PREPARE TRAINING DATA ==========
    pa_pr <- dplyr::filter(occ, species == sp)
    pa_bg <- dplyr::filter(bkg, species == sp)
    
    if (nrow(pa_pr) == 0) {
      msg("  [SKIP] No presence records")
      terra::close(env_r)
      pb$tick()
      next
    }
    
    part_cols <- grep("^\\.part", names(pa_pr), value = TRUE)
    pa <- dplyr::bind_rows(pa_pr, pa_bg) %>%
      dplyr::select(dplyr::any_of(c("x", "y", "pr_ab", "species", part_cols)))
    b <- dplyr::select(pa_bg, dplyr::any_of(c("x", "y", "pr_ab", "species", part_cols)))
    
    pa <- tryCatch(flexsdm::sdm_extract(pa, x = "x", y = "y", env_layer = env_r), error = function(e) NULL)
    b <- tryCatch(flexsdm::sdm_extract(b, x = "x", y = "y", env_layer = env_r), error = function(e) NULL)
    
    if (is.null(pa) || is.null(b)) {
      msg("  [SKIP] Environmental extraction failed")
      terra::close(env_r)
      pb$tick()
      next
    }
    
    pa <- tidyr::drop_na(pa)
    b <- tidyr::drop_na(b)
    
    n_pres <- nrow(dplyr::filter(pa, pr_ab == 1))
    msg("Training presences:", n_pres)
    
    if (n_pres < 5) {
      msg("  [SKIP] Too few presences")
      terra::close(env_r)
      pb$tick()
      next
    }
    
    # ========== FIT MODELS (SEQUENTIAL, NO NESTING) ==========
    msg("\nFitting models...")
    
    model_list <- list()
    
    # GLM
    if (n_pres >= 100) {
      m_glm <- tryCatch(
        flexsdm::fit_glm(
          data = pa, response = "pr_ab", predictors = var_names,
          partition = ".part", thr = "max_sens_spec", poly = 2
        ),
        error = function(e) NULL
      )
      if (!is.null(m_glm)) model_list$glm <- m_glm
    }
    
    # GAM
    if (n_pres >= 50) {
      n_training <- tryCatch(
        flexsdm:::n_training(data = pa, partition = ".part"),
        error = function(e) min(n_pres, 50)
      )
      candidate_k <- 20
      while (any(n_training < (candidate_k * 4)) && candidate_k > 3) candidate_k <- candidate_k - 1
      candidate_k <- max(3, candidate_k)
      
      m_gam <- tryCatch(
        flexsdm::fit_gam(
          data = pa, response = "pr_ab", predictors = var_names,
          partition = ".part", thr = "max_sens_spec", k = candidate_k
        ),
        error = function(e) NULL
      )
      if (!is.null(m_gam)) model_list$gam <- m_gam
    }
    
    # GAU
    if (n_pres >= 15) {
      m_gau <- tryCatch(
        flexsdm::fit_gau(
          data = pa, response = "pr_ab", predictors = var_names,
          partition = ".part", background = b, thr = "max_sens_spec"
        ),
        error = function(e) NULL
      )
      if (!is.null(m_gau)) model_list$gau <- m_gau
    }
    
    # GBM (REDUCED n_cores = 4)
    m_gbm <- tryCatch(
      flexsdm::tune_gbm(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", grid = grid_gbm,
        thr = "max_sens_spec", metric = "TSS", n_cores = n_cores
      ),
      error = function(e) NULL
    )
    if (!is.null(m_gbm)) model_list$gbm <- m_gbm
    
    # MAX (REDUCED n_cores = 4)
    m_max <- tryCatch(
      flexsdm::tune_max(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", background = b, grid = grid_max,
        thr = "max_sens_spec", metric = "TSS", n_cores = n_cores
      ),
      error = function(e) NULL
    )
    if (!is.null(m_max)) model_list$max <- m_max
    
    # NET (REDUCED n_cores = 4)
    grid_net <- expand.grid(
      size = 2:min(n_pred, 8),
      decay = seq(0.01, 0.5, 0.1)
    )
    m_net <- tryCatch(
      flexsdm::tune_net(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", grid = grid_net,
        thr = "max_sens_spec", metric = "TSS", n_cores = n_cores
      ),
      error = function(e) NULL
    )
    if (!is.null(m_net)) model_list$net <- m_net
    
    # RAF (REDUCED n_cores = 4)
    grid_raf <- expand.grid(
      mtry = 1:min(n_pred, 10),
      ntree = c(500, 1000)
    )
    m_raf <- tryCatch(
      flexsdm::tune_raf(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", grid = grid_raf,
        thr = "max_sens_spec", metric = "TSS", n_cores = n_cores
      ),
      error = function(e) NULL
    )
    if (!is.null(m_raf)) model_list$raf <- m_raf
    
    # SVM (REDUCED n_cores = 4)
    m_svm <- tryCatch(
      flexsdm::tune_svm(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", grid = grid_svm,
        thr = "max_sens_spec", metric = "TSS", n_cores = n_cores
      ),
      error = function(e) NULL
    )
    if (!is.null(m_svm)) model_list$svm <- m_svm
    
    msg("  Models fitted:", length(model_list), "of 8")
    
    if (length(model_list) == 0) {
      msg("  [SKIP] No models fitted")
      terra::close(env_r)
      cleanup_species()
      pb$tick()
      next
    }
    
    # ========== PERFORMANCE EVALUATION ==========
    msg("\nEvaluating performance...")
    perf_summary <- tryCatch(
      suppressWarnings(flexsdm::sdm_summarize(model_list)),
      error = function(e) NULL
    )
    
    if (!is.null(perf_summary)) {
      readr::write_delim(perf_summary, file.path(perf_dir, paste0(sp, "_performance.txt")), delim = "\t")
      msg("  Performance saved")
    }
    
    # Filter good models
    good_models <- if (!is.null(perf_summary)) {
      perf_summary$model[!is.na(perf_summary$AUC_mean) & perf_summary$AUC_mean >= auc_thr]
    } else {
      names(model_list)
    }
    
    model_list_good <- model_list[intersect(good_models, names(model_list))]
    msg("  Good models (AUC >= ", auc_thr, "):", length(model_list_good))
    
    # ========== UNCERTAINTY ANALYSIS ==========
    msg("\nUncertainty analysis...")
    
    if (length(model_list_good) >= 2) {
      uncertainty_rasters <- list()
      
      for (alg_name in names(model_list_good)) {
        unc_result <- tryCatch({
          flexsdm::sdm_uncertainty(
            models = model_list_good[[alg_name]],
            training_data = pa,
            response = "pr_ab",
            projection_data = env_r,
            iteration = unc_iterations,
            n_cores = unc_cores
          )
        }, error = function(e) NULL)
        
        if (!is.null(unc_result)) {
          uncertainty_rasters[[alg_name]] <- unc_result
        }
      }
      
      if (length(uncertainty_rasters) >= 2) {
        msg("  Stacking", length(uncertainty_rasters), "uncertainty rasters...")
        
        unc_stack <- terra::rast(uncertainty_rasters)
        
        # Use chunked app to prevent temp layer explosion
        mean_unc <- terra_app_chunked(unc_stack, fun = mean, na.rm = TRUE, chunk_size = 3)
        median_unc <- terra_app_chunked(unc_stack, fun = median, na.rm = TRUE, chunk_size = 3)
        sd_unc <- terra_app_chunked(unc_stack, fun = sd, na.rm = TRUE, chunk_size = 3)
        
        if (!is.null(mean_unc)) {
          terra::writeRaster(mean_unc,
            filename = file.path(uncertainty_dir, paste0(sp, "_uncertainty_mean.tif")),
            overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW"))
          )
          terra::close(mean_unc)
        }
        
        if (!is.null(median_unc)) {
          terra::writeRaster(median_unc,
            filename = file.path(uncertainty_dir, paste0(sp, "_uncertainty_median.tif")),
            overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW"))
          )
          terra::close(median_unc)
        }
        
        if (!is.null(sd_unc)) {
          terra::writeRaster(sd_unc,
            filename = file.path(uncertainty_dir, paste0(sp, "_model_agreement_sd.tif")),
            overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW"))
          )
          terra::close(sd_unc)
        }
        
        # Cleanup uncertainty rasters
        for (ur in uncertainty_rasters) terra::close(ur)
        terra::close(unc_stack)
        rm(uncertainty_rasters, unc_stack)
        
        msg("  Uncertainty rasters saved")
      }
    } else {
      msg("  Skipped (need >= 2 models)")
    }
    
    # ========== PREDICTIONS ON CURRENT ENVIRONMENT ==========
    msg("\nGenerating predictions...")
    
    for (alg in names(model_list_good)) {
      pred_result <- tryCatch(
        flexsdm::sdm_predict(
          models = list(model_list_good[[alg]]),
          pred = env_r,
          thr = "max_sens_spec",
          con_thr = TRUE,
          clamp = TRUE,
          pred_type = "cloglog"
        ),
        error = function(e) NULL
      )
      
      if (!is.null(pred_result)) {
        # Write continuous prediction
        con_r <- if (is.list(pred_result)) pred_result[[1]] else pred_result
        terra::writeRaster(con_r,
          filename = file.path(dir_alg_cur, alg, "1_con", paste0(sp, ".tif")),
          overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW"))
        )
        
        # Write binary prediction if available
        if (is.list(pred_result) && length(pred_result) >= 2) {
          bin_r <- pred_result[[2]]
          terra::writeRaster(bin_r,
            filename = file.path(dir_alg_cur, alg, "1_thr", paste0(sp, ".tif")),
            overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW"))
          )
          terra::close(bin_r)
        }
        
        # Explicit cleanup
        terra::close(con_r)
        if (is.list(pred_result)) {
          for (r in pred_result) terra::close(r)
        }
        rm(pred_result)
      }
    }
    
    msg("  Predictions saved")
    
    # ========== CLEANUP THIS SPECIES ==========
    terra::close(env_r)
    cleanup_species()
    
  }, error = function(e) {
    msg("[ERROR]", sp, ":", e$message)
    tryCatch(terra::close(env_r), error = function(e2) invisible(NULL))
    cleanup_species()
  })
  
  pb$tick()
}

