    if (hyp_count > 0) msg("  Hyperplots saved ✓ (", hyp_count, " plots)") else msg("  Hyperplots skipped ✗")
    
    # ========== MODEL SELECTION FOR ENSEMBLE ==========
    msg("\nModel selection (AUC >= 0.7)...")
    
    model_list_good <- list()
    good_model_names <- character(0)
    
    if (!is.null(model_perf)) {
      filt <- (!is.na(model_perf$AUC_mean)) & (model_perf$AUC_mean >= 0.7) &
        (!is.na(model_perf$thr_value)) & (model_perf$thr_value > 0) & (model_perf$thr_value < 1)
      
      good_model_names <- model_perf$model[filt]
      
      if (length(good_model_names) > 0) {
        model_list_good <- model_list_nonnull[intersect(good_model_names, names(model_list_nonnull))]
        msg("  Selected good models:", length(good_model_names), "✓")
        msg("    Models:", paste(good_model_names, collapse = ", "))
      } else {
        msg("  ⚠ No models passed threshold (AUC >= 0.7)")
      }
    }
    
    # ========== BUILD ENSEMBLE WITH GOOD MODELS ==========
    msg("\nBuilding ensemble with good models...")
    ens_m <- NULL
    ens_perf_table <- NULL
    
    if (length(model_list_good) >= 2) {
      ens_m <- tryCatch(
        flexsdm::fit_ensemble(models = model_list_good, ens_method = ensemble_methods, thr_model = "max_sens_spec", metric = "TSS"),
        error = function(e) NULL
      )
      if (!is.null(ens_m) && !is.null(ens_m$performance)) {
        ens_perf_table <- ens_m$performance
        readr::write_delim(ens_perf_table, file.path(perf_dir, paste0("02_ens_performance_", sp, ".txt")), delim = "\t")
        msg("  Ensemble built with", length(model_list_good), "models ✓")
      }
    } else if (length(model_list_good) == 1) {
      msg("Single model available, ensemble not created")
      ens_m <- NULL
    } else {
      msg("No good models available for ensemble")
    }
    
    # Save fitted models
    save_file <- file.path(mod_out_dir, paste0("01_fitted_models_", sp, ".RData"))
    tryCatch(
      save(ens_m, model_list_good, model_list_nonnull, uncertainty_result, predictors = var_names, training_data = pa, file = save_file),
      error = function(e) invisible(NULL)
    )
    msg("Fitted models saved ✓")
    
    # ============================================================================
    # STEP 7: EXPORT ALL PROJECTIONS (CURRENT, PALEO, FUTURE) FOR THIS SPECIES
    # ============================================================================
    
    
    models_for_prediction <- if (length(model_list_good) > 0) model_list_good else model_list_nonnull
    
    # ========== 7A: EXPORT CURRENT ==========
    msg("CURRENT projections...")
    
    current_alg_preds <- list()
    alg_con <- 0
    alg_thr <- 0
    
    for (alg in names(models_for_prediction)) {
      
      pr_alg <- tryCatch(
        flexsdm::sdm_predict(
          models = list(models_for_prediction[[alg]]),
          pred = env_r,
          thr = "max_sens_spec",
          con_thr = TRUE,
          clamp = TRUE,
          nchunk = 10,
          pred_type = "cloglog"
        ),
        error = function(e) {
          msg("        Error predicting", alg, ":", e$message)
          return(NULL)
        }
      )
      
      if (!is.null(pr_alg)) {
        con_r <- if (is.list(pr_alg)) pr_alg[[1]] else pr_alg
        thr_r <- if (is.list(pr_alg) && length(pr_alg) >= 2) pr_alg[[2]] else NULL
        
        if (!is.null(con_r)) {
          con_path <- file.path(dir_alg_cur, alg, "1_con", paste0(sp, ".tif"))
          thr_path <- file.path(dir_alg_cur, alg, "1_thr", paste0(sp, ".tif"))
          
          thr_val <- NA_real_
          if (!is.null(model_perf)) {
            row <- model_perf %>% dplyr::filter(model == alg)
            if (nrow(row) >= 1) thr_val <- suppressWarnings(as.numeric(row$thr_value[1]))
          }
          
          # Write continuous raster
          dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
          con_success <- !is.null(tryCatch({
            terra::writeRaster(con_r, con_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
            TRUE
          }, error = function(e) NULL))
          
          # Write threshold raster
          thr_success <- FALSE
          if (!is.null(thr_r)) {
            dir.create(dirname(thr_path), recursive = TRUE, showWarnings = FALSE)
            thr_success <- !is.null(tryCatch({
              terra::writeRaster(thr_r, thr_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
              TRUE
            }, error = function(e) NULL))
          } else if (con_success && !is.na(thr_val) && thr_val > 0 && thr_val < 1) {
            dir.create(dirname(thr_path), recursive = TRUE, showWarnings = FALSE)
            thr_calc <- tryCatch((con_r >= thr_val) * 1, error = function(e) NULL)
            if (!is.null(thr_calc)) {
              thr_success <- !is.null(tryCatch({
                terra::writeRaster(thr_calc, thr_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
                TRUE
              }, error = function(e) NULL))
            }
          }
          
          if (con_success) alg_con <- alg_con + 1
          if (thr_success) alg_thr <- alg_thr + 1
          
          if (alg %in% good_model_names) current_alg_preds[[alg]] <- con_r
        }
      }
    }
    
    msg("Algorithms: con:", alg_con, "| thr:", alg_thr, "✓")
    
    # Current ensemble
    ens_con <- 0
    ens_thr <- 0
    if (length(current_alg_preds) >= 2 && !is.null(ens_perf_table)) {
      m_list <- terra::rast(current_alg_preds)
      w <- model_perf$TSS_mean[model_perf$model %in% names(current_alg_preds)]
      thr_mod <- model_perf$thr_value[model_perf$model %in% names(current_alg_preds)]
      
      thr_vals <- if (!is.null(ens_perf_table) && "thr_value" %in% names(ens_perf_table)) {
        tv <- ens_perf_table$thr_value[ens_perf_table$model %in% ensemble_methods]
        if (length(tv) < length(ensemble_methods)) rep(mean(thr_mod, na.rm = TRUE), length(ensemble_methods)) else tv
      } else {
        rep(mean(thr_mod, na.rm = TRUE), length(ensemble_methods))
      }
      
      for (j in seq_along(ensemble_methods)) {
        method <- ensemble_methods[j]
        thr_val <- thr_vals[j]
        
        ens_result <- tryCatch({
          if (method == "meanw") {
            m <- terra::weighted.mean(m_list, w, na.rm = TRUE)
            c(m, m * (m >= thr_val))
          } else if (method == "mean") {
            m <- terra::app(m_list, fun = mean, na.rm = TRUE)
            c(m, m * (m >= thr_val))
          } else if (method == "median") {
            m <- terra::app(m_list, fun = median, na.rm = TRUE)
            c(m, m * (m >= thr_val))
          } else if (method == "meansup") {
            m <- terra::mean(m_list[[which(w >= mean(w))]], na.rm = TRUE)
            c(m, m * (m >= thr_val))
          } else if (method == "meanthr") {
            m_list_copy <- m_list
            for (r in 1:terra::nlyr(m_list_copy)) {
              m_list_copy[[r]][m_list_copy[[r]] < thr_mod[r]] <- 0
            }
            m <- terra::app(m_list_copy, fun = mean, na.rm = TRUE)
            c(m, m * (m >= thr_val))
          } else NULL
        }, error = function(e) NULL)
        
        if (!is.null(ens_result) && length(ens_result) >= 1) {
          con_path <- file.path(dir_ens_cur, method, "1_con", paste0(sp, ".tif"))
