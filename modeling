        pal_ens_thr <- 0
        
        if (length(paleo_alg_preds) >= 2 && !is.null(ens_perf_table)) {
          m_list_pal <- terra::rast(paleo_alg_preds)
          w_pal <- model_perf$TSS_mean[model_perf$model %in% names(paleo_alg_preds)]
          thr_mod_pal <- model_perf$thr_value[model_perf$model %in% names(paleo_alg_preds)]
          
