msg("  Ensemble methods:", paste(ensemble_methods, collapse = ", "))
msg("  Plot DPI:", 500)
msg("  Uncertainty Analysis:")
msg("    Iterations:", 250)
msg("    Cores:", 10)
msg("  Future scenarios (", nrow(future_grid), "):")
msg("    GCMs:", paste(gcms, collapse = ", "))
msg("    Periods:", paste(periods, collapse = ", "))
msg("    SSPs:", paste(ssps, collapse = ", "))
msg("")

terra::terraOptions(memfrac = 0.7)

# ============================================================================
# SECTION 2: LOAD DATA
# ============================================================================

msg(strrep("=", 80))
msg(">>> SECTION 2: LOADING DATA <<<")
msg(strrep("=", 80), "\n")

msg("Reading occurrence and background data...")
occ <- data.table::fread(occ_file) %>% tibble::as_tibble()
bkg <- data.table::fread(bkg_file) %>% tibble::as_tibble()

# Ensure partition exists
if (!(".part" %in% names(occ))) {
  set.seed(42)
  n <- max(1, length(unique(na.omit(occ$.part))))
  occ$.part <- sample(rep(seq_len(n), length.out = nrow(occ)))
}

msg("Loaded", nrow(occ), "occurrence records")
msg("Loaded", nrow(bkg), "background records")
msg("")

msg("Loading environmental raster metadata...")
env_files <- list.files(env_cur_dir, pattern = "\\.tif$", full.names = TRUE)
pca_species <- gsub("\\.tif$", "", basename(env_files))
sp_available <- intersect(unique(occ$species), pca_species)

paleo_types <- list.dirs(env_pal_dir, recursive = FALSE, full.names = FALSE)
if (length(paleo_types) == 0) paleo_types <- c()

msg("Species available:", length(sp_available))
msg("Paleo climate types:", if (length(paleo_types) > 0) paste(paleo_types, collapse = ", ") else "none")
msg("")

# ============================================================================
# SECTION 3: CREATE OUTPUT DIRECTORIES
# ============================================================================

msg(strrep("=", 80))
msg("SECTION 3: CREATING OUTPUT DIRECTORIES")
msg(strrep("=", 80), "\n")

algorithms <- c("glm", "gam", "gau", "gbm", "max", "net", "raf", "svm")

# Current outputs
for (alg in algorithms) {
  dir.create(file.path(out_base, "01_Current", "04_Algorithm", alg, "1_con"), recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(out_base, "01_Current", "04_Algorithm", alg, "1_thr"), recursive = TRUE, showWarnings = FALSE)
}
for (ens_method in ensemble_methods) {
  dir.create(file.path(out_base, "01_Current", "05_Ensemble", ens_method, "1_con"), recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(out_base, "01_Current", "05_Ensemble", ens_method, "1_thr"), recursive = TRUE, showWarnings = FALSE)
}
dir.create(file.path(out_base, "01_Current", "01_ModelPerformance"), recursive = TRUE, showWarnings = FALSE)
dir.create(file.path(out_base, "01_Current", "03_ModelFitted"), recursive = TRUE, showWarnings = FALSE)
dir.create(file.path(out_base, "01_Current", "07_HypPlot"), recursive = TRUE, showWarnings = FALSE)
dir.create(file.path(out_base, "01_Current", "06_PDP_Plots"), recursive = TRUE, showWarnings = FALSE)
dir.create(file.path(out_base, "01_Current", "08_Uncertainty"), recursive = TRUE, showWarnings = FALSE)

# Paleo projection outputs
if (length(paleo_types) > 0) {
  for (ptype in paleo_types) {
    for (alg in algorithms) {
      dir.create(file.path(out_base, "02_Projection", "01_Paleo", ptype, "05_Algorithm", alg, "1_con"), recursive = TRUE, showWarnings = FALSE)
      dir.create(file.path(out_base, "02_Projection", "01_Paleo", ptype, "05_Algorithm", alg, "1_thr"), recursive = TRUE, showWarnings = FALSE)
    }
    for (ens_method in ensemble_methods) {
      dir.create(file.path(out_base, "02_Projection", "01_Paleo", ptype, "06_Ensemble", ens_method, "1_con"), recursive = TRUE, showWarnings = FALSE)
      dir.create(file.path(out_base, "02_Projection", "01_Paleo", ptype, "06_Ensemble", ens_method, "1_thr"), recursive = TRUE, showWarnings = FALSE)
    }
    dir.create(file.path(out_base, "02_Projection", "01_Paleo", ptype, "07_Uncertainty"), recursive = TRUE, showWarnings = FALSE)
  }
}

# Future projection outputs
for (idx in seq_len(nrow(future_grid))) {
  gcm <- future_grid$GCM[idx]
  period <- future_grid$PERIOD[idx]
  ssp <- future_grid$SSP[idx]
  for (alg in algorithms) {
