              if (thr_success) pal_ens_thr <- pal_ens_thr + 1
            }
          }
        } else if (length(paleo_alg_preds) >= 2) {
          msg("Ensemble performance not available, skipping paleo ensemble prediction")
        }
        
        msg("Ensembles: con:", pal_ens_con, "| thr:", pal_ens_thr, "✓")
      }
      
      msg("PALEO projections complete (all", length(paleo_types), "types)")
      msg("")
    }
    
    # ========== 7C: EXPORT FUTURE (ALL GCM/PERIOD/SSP COMBINATIONS) ==========
    if (nrow(future_grid) > 0 && length(models_for_prediction) > 0) {
      msg("\nFUTURE projections (", nrow(future_grid), " scenarios)...")
      
      for (idx in seq_len(nrow(future_grid))) {
