                c(m, m * (m >= thr_val_pal))
              } else if (method == "mean") {
                m <- terra::app(m_list_pal, fun = mean, na.rm = TRUE)
                c(m, m * (m >= thr_val_pal))
              } else if (method == "median") {
                m <- terra::app(m_list_pal, fun = median, na.rm = TRUE)
                c(m, m * (m >= thr_val_pal))
              } else if (method == "meansup") {
                m <- terra::mean(m_list_pal[[which(w_pal >= mean(w_pal))]], na.rm = TRUE)
                c(m, m * (m >= thr_val_pal))
              } else if (method == "meanthr") {
                m_list_pal_copy <- m_list_pal
                for (r in 1:terra::nlyr(m_list_pal_copy)) {
                  m_list_pal_copy[[r]][m_list_pal_copy[[r]] < thr_mod_pal[r]] <- 0
                }
                m <- terra::app(m_list_pal_copy, fun = mean, na.rm = TRUE)
                c(m, m * (m >= thr_val_pal))
              } else NULL
            }, error = function(e) NULL)
            
            if (!is.null(ens_result_pal) && length(ens_result_pal) >= 1) {
              con_path <- file.path(proj_out_base, "01_Paleo", ptype, "06_Ensemble", method, "1_con", paste0(sp, ".tif"))
              thr_path <- file.path(proj_out_base, "01_Paleo", ptype, "06_Ensemble", method, "1_thr", paste0(sp, ".tif"))
              
              dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
              con_success <- !is.null(tryCatch({
                terra::writeRaster(ens_result_pal[[1]], con_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
                TRUE
              }, error = function(e) NULL))
              
