                c(m, m * (m >= thr_val_fut))
              } else if (method == "mean") {
                m <- terra::app(m_list_fut, fun = mean, na.rm = TRUE)
                c(m, m * (m >= thr_val_fut))
              } else if (method == "median") {
                m <- terra::app(m_list_fut, fun = median, na.rm = TRUE)
                c(m, m * (m >= thr_val_fut))
              } else if (method == "meansup") {
                m <- terra::mean(m_list_fut[[which(w_fut >= mean(w_fut))]], na.rm = TRUE)
                c(m, m * (m >= thr_val_fut))
              } else if (method == "meanthr") {
                m_list_fut_copy <- m_list_fut
                for (r in 1:terra::nlyr(m_list_fut_copy)) {
                  m_list_fut_copy[[r]][m_list_fut_copy[[r]] < thr_mod_fut[r]] <- 0
                }
                m <- terra::app(m_list_fut_copy, fun = mean, na.rm = TRUE)
                c(m, m * (m >= thr_val_fut))
              } else NULL
            }, error = function(e) NULL)
            
            if (!is.null(ens_result_fut) && length(ens_result_fut) >= 1) {
              con_path <- file.path(proj_out_base, "02_Future", gcm, period, ssp, "06_Ensemble", method, "1_con", paste0(sp, ".tif"))
              thr_path <- file.path(proj_out_base, "02_Future", gcm, period, ssp, "06_Ensemble", method, "1_thr", paste0(sp, ".tif"))
              
              dir.create(dirname(con_path), recursive = TRUE, showWarnings = FALSE)
              con_success <- !is.null(tryCatch({
                terra::writeRaster(ens_result_fut[[1]], con_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
                TRUE
              }, error = function(e) NULL))
              
              thr_success <- FALSE
              thr_r_fut <- if (length(ens_result_fut) >= 2) ens_result_fut[[2]] else NULL
              if (!is.null(thr_r_fut)) {
                dir.create(dirname(thr_path), recursive = TRUE, showWarnings = FALSE)
                thr_success <- !is.null(tryCatch({
                  terra::writeRaster(thr_r_fut, thr_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
                  TRUE
                }, error = function(e) NULL))
              } else if (con_success && !is.na(thr_val_fut) && thr_val_fut > 0 && thr_val_fut < 1) {
                dir.create(dirname(thr_path), recursive = TRUE, showWarnings = FALSE)
                thr_calc <- tryCatch((ens_result_fut[[1]] >= thr_val_fut) * 1, error = function(e) NULL)
                if (!is.null(thr_calc)) {
                  thr_success <- !is.null(tryCatch({
                    terra::writeRaster(thr_calc, thr_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
                    TRUE
                  }, error = function(e) NULL))
                }
              }
              
              if (con_success) fut_ens_con <- fut_ens_con + 1
              if (thr_success) fut_ens_thr <- fut_ens_thr + 1
            }
          }
        } else if (length(future_alg_preds) >= 2) {
          msg("Ensemble performance not available, skipping future ensemble prediction")
        }
        
        msg("Ensembles: con:", fut_ens_con, "| thr:", fut_ens_thr, "✓")
      }
      
      msg("FUTURE projections complete (all", nrow(future_grid), "scenarios)")
      msg("")
    }
    
    # ========== SPECIES COMPLETE - ALL SCENARIOS FINISHED ==========
    msg("SPECIES COMPLETE - All scenarios processed successfully")
    msg(strrep("-", nchar(header$line)))
    msg("")
    
    # Clean up for this species before moving to next
    rm(list = grep("^m_", ls(), value = TRUE), envir = environment())
    if (exists("env_r")) rm(env_r, envir = environment())
    if (exists("env_pal")) rm(env_pal, envir = environment())
    if (exists("env_fut")) rm(env_fut, envir = environment())
    gc()
    
  }, error = function(e) {
    msg("ERROR for species", sp, ":", conditionMessage(e))
    msg("Moving to next species...")
    msg(strrep("-", nchar(header$line)))
    msg("")
  })
  
  pb$tick()
}

