          con_success <- !is.null(tryCatch({
            terra::writeRaster(ens_result[[1]], con_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
            TRUE
          }, error = function(e) NULL))
          
          thr_success <- FALSE
          thr_r_ens <- if (length(ens_result) >= 2) ens_result[[2]] else NULL
          if (!is.null(thr_r_ens)) {
            dir.create(dirname(thr_path), recursive = TRUE, showWarnings = FALSE)
            thr_success <- !is.null(tryCatch({
              terra::writeRaster(thr_r_ens, thr_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
              TRUE
            }, error = function(e) NULL))
          } else if (con_success && !is.na(thr_val) && thr_val > 0 && thr_val < 1) {
            dir.create(dirname(thr_path), recursive = TRUE, showWarnings = FALSE)
            thr_calc <- tryCatch((ens_result[[1]] >= thr_val) * 1, error = function(e) NULL)
            if (!is.null(thr_calc)) {
              thr_success <- !is.null(tryCatch({
                terra::writeRaster(thr_calc, thr_path, overwrite = TRUE, wopt = list(gdal = c("COMPRESS=LZW")))
                TRUE
              }, error = function(e) NULL))
            }
          }
          
          if (con_success) ens_con <- ens_con + 1
          if (thr_success) ens_thr <- ens_thr + 1
        }
      }
    } else if (length(current_alg_preds) >= 2) {
      msg("Ensemble performance not available, skipping ensemble prediction")
    }
    
    msg("Ensembles: con:", ens_con, "| thr:", ens_thr, "✓")
    msg("CURRENT projections complete")
    msg("")
    
    # ========== 7B: EXPORT PALEO (ALL TYPES) ==========
