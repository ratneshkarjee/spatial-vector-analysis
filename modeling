msg <- function(...) cat(paste(..., sep = " "), "\n")

create_header <- function(sp, i, total) {
  header_text <- paste0("SPECIES:  ", sp, "  [ ", i, " / ", total, " ]")
  header_width <- nchar(header_text)
  line <- strrep("=", header_width)
  list(line = line, text = header_text)
}

print_header <- function(header_obj) {
  msg(header_obj$line)
  msg(header_obj$text)
  msg(header_obj$line)
}

# ============================================================================
# SECTION 1: CONFIGURATION & PATH SETUP
# ============================================================================

msg(strrep("=", 80))
msg(">>> CONFIGURING PATHS AND PARAMETERS <<<")
msg(strrep("=", 80), "\n")

base_dir <- "/DATA3/Ratnesh/sdm_new/flexsdm"
msg("Base Directory:", base_dir)

occ_dir <- file.path(base_dir, "01_Outputs", "02_Filtered_occurrences")
occ_file <- file.path(occ_dir, "1_occ_presabs_partitioned.gz")
bkg_file <- file.path(occ_dir, "1_occ_bkgroud_partitioned.gz")

env_cur_dir <- file.path(base_dir, "01_Outputs", "04_Predictors_by_species", "01_Current")

# UPDATED: Paleo and Future paths now point to 02_Projection
env_pal_dir <- file.path(base_dir, "01_Outputs", "04_Predictors_by_species", "02_Projection", "01_Paleo")
env_fut_dir <- file.path(base_dir, "01_Outputs", "04_Predictors_by_species", "02_Projection", "02_Future")

out_base <- file.path(base_dir, "01_Outputs", "01_SDM_outputs")

msg("Occurrence directory:", occ_dir)
msg("Climate data (Current):", env_cur_dir)
msg("Climate data (Paleo):", env_pal_dir)
msg("Climate data (Future):", env_fut_dir)
