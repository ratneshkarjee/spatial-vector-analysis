        }, error = function(e) NULL)
        if (!is.null(p)) {
          safe_ggsave_with_devoff(
            file.path(hypplot_cur, paste0(sp, "_hyp_raf_", if(metric == "AUC_mean") "auc" else "tss", ".png")),
            p, width = 10, height = 7, dpi = 500
          )
        }
      }
      readr::write_tsv(h, file.path(hypplot_cur, paste0(sp, "_hyp_raf.txt")))
    }
    
    if (!is.null(m_svm) && !is.null(m_svm$hyper_performance) && nrow(m_svm$hyper_performance) > 0) {
      h <- m_svm$hyper_performance
      for (metric in c("AUC_mean", "TSS_mean")) {
        p <- tryCatch({
          ggplot2::ggplot(h, ggplot2::aes_string(x = "sigma", y = metric, col = "as.factor(C)")) +
            ggplot2::geom_line() + ggplot2::theme_bw() +
            ggplot2::ggtitle(bquote(italic(.(sp_display)) ~ "(SVM)")) +
            ggplot2::theme(plot.title = ggplot2::element_text(hjust = 0.5, size = 12), legend.position = "right")
        }, error = function(e) NULL)
        if (!is.null(p)) {
          safe_ggsave_with_devoff(
            file.path(hypplot_cur, paste0(sp, "_hyp_svm_", if(metric == "AUC_mean") "auc" else "tss", ".png")),
            p, width = 12, height = 8, dpi = 500
          )
        }
      }
      readr::write_tsv(h, file.path(hypplot_cur, paste0(sp, "_hyp_svm.txt")))
    }
    
    msg("Hyperparameter plots saved ✓")
    
    # ========== CLEANUP THIS SPECIES ==========
    # FIX #9: Explicit raster closure before next species
    # WHY: env_r persists into next species if not closed. Each species must
    # start with zero GDAL handles from previous iteration.
    
    close_raster_safely(env_r)
    
    # FIX #10: Complete cleanup between species
    # WHY: After all operations (models, predictions, plots), accumulated temp
    # files and objects must be purged before next species loads its environment.
    cleanup_after_species()
    
  }, error = function(e) {
    # Ensure cleanup even on fatal error
    msg("[ERROR]", sp, ":", e$message)
    tryCatch({
      close_raster_safely(env_r)
    }, error = function(e2) invisible(NULL))
    cleanup_after_species()
  })
  
  pb$tick()
