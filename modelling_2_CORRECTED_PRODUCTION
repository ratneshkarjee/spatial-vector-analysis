msg(strrep("=", 80))
msg("SECTION 4: MODEL FITTING & PROJECTION (SEQUENTIAL BY SPECIES)")
msg(strrep("=", 80), "\n")

pb <- progress::progress_bar$new(
  total = length(sp_available),
  format = "[:bar] :current/:total (:percent) | :elapsed | :eta",
  width = 60
)

for (i in seq_along(sp_available)) {
  
  sp <- sp_available[i]
  sp_display <- gsub("_", " ", sp)
  
  set.seed(123 + i)
  
  header <- create_header(sp, i, length(sp_available))
  print_header(header)
  
  msg("")
  
  # FIX #1: Use tryCatch to ensure cleanup even on error
  # WHY: If an algorithm fails mid-species, we must still close rasters and cleanup
  tryCatch({
    
    # ========== LOAD CURRENT ENVIRONMENTAL DATA (PER-SPECIES) ==========
    # FIX #1: Load raster INSIDE species loop, NOT globally
    # WHY: Global raster loading keeps GDAL handles open for all species.
    # Per-species loading + explicit close() maintains bounded handle count.
    
    msg("\nLoading environmental data...")
    
    cur_env_file <- file.path(env_cur_dir, paste0(sp, ".tif"))
    if (!file.exists(cur_env_file)) {
      msg("⚠ No CURRENT PCA file | SKIPPING SPECIES")
      msg(strrep("-", nchar(header$line)))
      msg("")
      pb$tick()
      next
    }
    
    env_r <- tryCatch(terra::rast(cur_env_file), error = function(e) NULL)
    if (is.null(env_r)) {
      msg("Cannot load CURRENT PCA | SKIPPING SPECIES")
      msg(strrep("-", nchar(header$line)))
      msg("")
      pb$tick()
      next
    }
    
    var_names <- names(env_r)
    msg("Predictors:", length(var_names), "✓")
    
    # ========== PREPARE TRAINING DATA ==========
    msg("Preparing training data...")
    
    pa_pr <- dplyr::filter(occ, species == sp)
    pa_bg <- dplyr::filter(bkg, species == sp)
    
    if (nrow(pa_pr) == 0) {
      msg("No presence records | SKIPPING SPECIES")
      msg(strrep("-", nchar(header$line)))
      msg("")
      close_raster_safely(env_r)
      pb$tick()
      next
    }
    
    part_cols <- grep("^\\.part", names(pa_pr), value = TRUE)
    pa <- dplyr::select(
      dplyr::bind_rows(pa_pr, pa_bg),
      dplyr::any_of(c("x", "y", "pr_ab", "species", part_cols))
    )
    b <- dplyr::select(pa_bg, dplyr::any_of(c("x", "y", "pr_ab", "species", part_cols)))
    
    pa <- tryCatch(flexsdm::sdm_extract(pa, x = "x", y = "y", env_layer = env_r), error = function(e) NULL)
    b  <- tryCatch(flexsdm::sdm_extract(b,  x = "x", y = "y", env_layer = env_r), error = function(e) NULL)
    
    if (is.null(pa) || is.null(b)) {
      msg("Environmental data extraction failed | SKIPPING SPECIES")
      msg(strrep("-", nchar(header$line)))
      msg("")
      close_raster_safely(env_r)
      pb$tick()
      next
    }
    
    pa <- tidyr::drop_na(pa)
    b <- tidyr::drop_na(b)
    
    n_pres <- nrow(dplyr::filter(pa, pr_ab == 1))
    msg("  Training presences:", n_pres, "✓")
    
    if (n_pres < 5) {
      msg("Insufficient presences (< 5) | SKIPPING SPECIES")
      msg(strrep("-", nchar(header$line)))
      msg("")
      close_raster_safely(env_r)
      pb$tick()
      next
    }
    
    # ========== FIT MODELS ==========
    msg("\nFitting models...")
    
    m_glm <- NULL
    m_gam <- NULL
    m_gau <- NULL
    m_gbm <- NULL
    m_max <- NULL
    m_net <- NULL
    m_raf <- NULL
    m_svm <- NULL
    
    # GLM
    msg("GLM fitting...")
    if (n_pres >= 100) {
      m_glm <- tryCatch(
        flexsdm::fit_glm(
          data = pa, response = "pr_ab", predictors = var_names,
          partition = ".part", thr = "max_sens_spec", poly = 2
        ),
        error = function(e) NULL
      )
      msg("GLM", if (!is.null(m_glm)) "✓" else "✗")
    } else {
      msg("GLM (skipped - n < 100)")
    }
    
    # GAM
    msg("GAM fitting...")
    if (n_pres >= 50) {
      n_training <- tryCatch(
        flexsdm:::n_training(data = pa, partition = ".part"),
        error = function(e) min(n_pres, 50)
      )
      candidate_k <- 20
      while (any(n_training < (candidate_k * 4)) && candidate_k > 3) {
        candidate_k <- candidate_k - 1
      }
      candidate_k <- max(3, candidate_k)
      
      m_gam <- tryCatch(
        flexsdm::fit_gam(
          data = pa, response = "pr_ab", predictors = var_names,
          partition = ".part", thr = "max_sens_spec", k = candidate_k
        ),
        error = function(e) {
          tryCatch(
            flexsdm::fit_gam(
              data = pa, response = "pr_ab", predictors = var_names,
              partition = ".part", thr = "max_sens_spec", k = 5
            ),
            error = function(e2) NULL
          )
        }
      )
      msg("GAM", if (!is.null(m_gam)) "✓" else "✗")
    } else {
      msg("GAM (skipped - n < 50)")
    }
    
    # GAU
    msg("GAU fitting...")
    if (n_pres >= 15) {
      m_gau <- tryCatch(
        flexsdm::fit_gau(
          data = pa, response = "pr_ab", predictors = var_names,
          partition = ".part", background = b, thr = "max_sens_spec"
        ),
        error = function(e) NULL
      )
      msg("GAU", if (!is.null(m_gau)) "✓" else "✗")
    } else {
      msg("GAU (skipped - n < 15)")
    }
    
    # GBM
    msg("GBM tuning...")
    set.seed(123)
    grid_gbm <- expand.grid(
      n.trees = seq(150, 200, 10),
      shrinkage = seq(1, 1.5, 0.2),
      n.minobsinnode = seq(1, 15, 2)
    )
    m_gbm <- tryCatch(
      flexsdm::tune_gbm(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", grid = grid_gbm,
        thr = "max_sens_spec", metric = "TSS", n_cores = 10
      ),
      error = function(e) NULL
    )
    if (!is.null(m_gbm)) {
      best_perf <- m_gbm$hyper_performance %>% dplyr::arrange(desc(TSS_mean)) %>% dplyr::slice(1)
      msg("      Best GBM: trees=", best_perf$n.trees[1], " shrinkage=", best_perf$shrinkage[1], " minobs=", best_perf$n.minobsinnode[1], " TSS=", round(best_perf$TSS_mean[1], 4))
    }
    msg("GBM", if (!is.null(m_gbm)) "✓" else "✗")
    
    # MAX
    msg("MAX tuning...")
    set.seed(123)
    grid_max <- expand.grid(
      regmult = seq(0.1, 2, 0.5),
      classes = c("lq", "lqh", "lqhp", "lqhpt")
    )
    m_max <- tryCatch(
      flexsdm::tune_max(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", background = b, grid = grid_max,
        thr = "max_sens_spec", metric = "TSS", n_cores = 10
      ),
      error = function(e) NULL
    )
    if (!is.null(m_max)) {
      best_perf <- m_max$hyper_performance %>% dplyr::arrange(desc(TSS_mean)) %>% dplyr::slice(1)
      msg("      Best MAX: regmult=", best_perf$regmult[1], " classes=", best_perf$classes[1], " TSS=", round(best_perf$TSS_mean[1], 4))
    }
    msg("MAX", if (!is.null(m_max)) "✓" else "✗")
    
    # NET
    msg("NET tuning...")
    set.seed(123)
    n_pred <- length(var_names)
    grid_net <- expand.grid(
      size = 2:n_pred,
      decay = c(seq(0.01, 1, 0.05), 1, 3, 4, 5, 6)
    )
    m_net <- tryCatch(
      flexsdm::tune_net(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", grid = grid_net,
        thr = "max_sens_spec", metric = "TSS", n_cores = 10
      ),
      error = function(e) NULL
    )
    if (!is.null(m_net)) {
      best_perf <- m_net$hyper_performance %>% dplyr::arrange(desc(TSS_mean)) %>% dplyr::slice(1)
      msg("      Best NET: size=", best_perf$size[1], " decay=", best_perf$decay[1], " TSS=", round(best_perf$TSS_mean[1], 4))
    }
    msg("NET", if (!is.null(m_net)) "✓" else "✗")
    
    # RAF
    msg("RAF tuning...")
    set.seed(123)
    n_pred <- length(var_names)
    grid_raf <- expand.grid(
      mtry = seq(1, n_pred, 1),
      ntree = c(400, 600, 800, 1000)
    )
    m_raf <- tryCatch(
      flexsdm::tune_raf(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", grid = grid_raf,
        thr = "max_sens_spec", metric = "TSS", n_cores = 10
      ),
      error = function(e) NULL
    )
    if (!is.null(m_raf)) {
      best_perf <- m_raf$hyper_performance %>% dplyr::arrange(desc(TSS_mean)) %>% dplyr::slice(1)
      msg("      Best RAF: mtry=", best_perf$mtry[1], " ntree=", best_perf$ntree[1], " TSS=", round(best_perf$TSS_mean[1], 4))
    }
    msg("RAF", if (!is.null(m_raf)) "✓" else "✗")
    
    # SVM
    msg("SVM tuning...")
    set.seed(123)
    grid_svm <- expand.grid(
      C = seq(2, 60, 5),
      sigma = seq(0.001, 0.3, 0.01)
    )
    m_svm <- tryCatch(
      flexsdm::tune_svm(
        data = pa, response = "pr_ab", predictors = var_names,
        partition = ".part", grid = grid_svm,
        thr = "max_sens_spec", metric = "TSS", n_cores = 10
      ),
      error = function(e) NULL
    )
    if (!is.null(m_svm)) {
      best_perf <- m_svm$hyper_performance %>% dplyr::arrange(desc(TSS_mean)) %>% dplyr::slice(1)
      msg("      Best SVM: C=", best_perf$C[1], " sigma=", best_perf$sigma[1], " TSS=", round(best_perf$TSS_mean[1], 4))
    }
    msg("SVM", if (!is.null(m_svm)) "✓" else "✗")
    
    model_list_all <- list(
      glm = m_glm, gam = m_gam, gau = m_gau, gbm = m_gbm,
      max = m_max, net = m_net, raf = m_raf, svm = m_svm
    )
    model_list_nonnull <- model_list_all[!vapply(model_list_all, is.null, logical(1))]
    msg("Models fitted:", length(model_list_nonnull), "of 8 ✓")
    
    if (length(model_list_nonnull) == 0) {
      msg("No models fitted | SKIPPING SPECIES")
      close_raster_safely(env_r)
      cleanup_after_species()
      pb$tick()
      next
    }
    
    # ========== PERFORMANCE EVALUATION ==========
    msg("\nPerformance evaluation...")
    model_perf <- NULL
    if (length(model_list_nonnull) > 0) {
      perf_summary <- tryCatch(
        suppressWarnings(flexsdm::sdm_summarize(model_list_nonnull)),
        error = function(e) NULL
      )
      if (!is.null(perf_summary)) {
        model_perf <- perf_summary
        readr::write_delim(model_perf, file.path(perf_dir, paste0("01_fit_performance_", sp, ".txt")), delim = "\t")
        msg("  Performance saved ✓")
      }
    }
    
    # ========== VARIABLE IMPORTANCE ==========
    msg("\nVariable importance...")
    if (length(var_names) > 0 && length(model_list_nonnull) > 0) {
      pred_sds <- sapply(pa[, intersect(var_names, names(pa)), drop = FALSE],
        function(x) if (is.numeric(x)) stats::sd(x, na.rm = TRUE) else NA_real_
      )
      good_preds <- names(pred_sds)[!is.na(pred_sds) & pred_sds > 0]
      
      if (length(good_preds) > 0) {
        varimp_out <- list()
        for (alg in names(model_list_nonnull)) {
          v_res <- tryCatch(
            flexsdm::sdm_varimp(
              models = list(model_list_nonnull[[alg]]),
              data = pa, response = "pr_ab", predictors = good_preds,
              n_sim = 250, n_cores = 6,
              thr = "max_sens_spec", clamp = TRUE
            ),
            error = function(e) NULL
          )
          
          if (!is.null(v_res)) {
            vdf <- if (is.data.frame(v_res)) v_res else if (is.list(v_res)) as.data.frame(v_res) else NULL
            if (!is.null(vdf)) {
              if (!("variable" %in% names(vdf))) vdf <- tibble::rownames_to_column(vdf, var = "variable")
              num_cols <- names(vdf)[sapply(vdf, is.numeric) & names(vdf) != "variable"]
              if (length(num_cols) > 0) {
                varimp_out[[alg]] <- tibble::tibble(
                  variable = as.character(vdf$variable),
                  importance_mean = as.numeric(rowMeans(vdf[, num_cols, drop = FALSE], na.rm = TRUE)),
                  importance_median = as.numeric(apply(vdf[, num_cols, drop = FALSE], 1, median, na.rm = TRUE)),
                  importance_sd = as.numeric(apply(vdf[, num_cols, drop = FALSE], 1, sd, na.rm = TRUE)),
                  model = alg
                )
              }
            }
          }
        }
        
        if (length(varimp_out) > 0) {
          readr::write_delim(
            dplyr::bind_rows(varimp_out),
            file.path(perf_dir, paste0("03_varimp_", sp, ".txt")),
            delim = "\t"
          )
          msg("Variable importance saved ✓")
        }
      }
    }
    
    # ========== UNCERTAINTY ANALYSIS ==========
    # FIX #5: Proper uncertainty raster cleanup
    # WHY: Uncertainty analysis creates N rasters that accumulate in memory.
    # After processing, we MUST: 1) close all rasters explicitly,
    # 2) remove references, 3) run cleanup_after_species()
    
    msg("\nRunning uncertainty analysis...")
    
    successful_models <- model_list_nonnull[!sapply(model_list_nonnull, is.null)]
    uncertainty_result <- NULL
    
    if(length(successful_models) >= 2) {
      msg("    Running uncertainty analysis...")
      msg("      Iterations: 250")
      
      uncertainty_rasters <- list()
      
      for(alg_name in names(successful_models)) {
        msg("      Processing", alg_name, "...")
        
        unc_result <- tryCatch({
          flexsdm::sdm_uncertainty(
            models = successful_models[[alg_name]],
            training_data = pa,
            response = "pr_ab",
            projection_data = env_r,
            iteration = 250,
            n_cores = 10
          )
        }, error = function(e) {
          msg("        Error in", alg_name, "uncertainty:", e$message)
          return(NULL)
        })
        
        if(!is.null(unc_result)) {
          uncertainty_rasters[[alg_name]] <- unc_result
          msg("        Uncertainty calculated ✓")
        } else {
          msg("        Failed")
        }
      }
      
      if(length(uncertainty_rasters) >= 2) {
        msg("\nStacking uncertainty rasters...")
        
        unc_stack <- terra::rast(uncertainty_rasters)
        
        # FIX #6: terra::app() processes layers individually
        # WHY: terra::app() creates intermediate temp rasters for each operation.
        # On large stacks (8+ layers), this can create 24+ intermediate temp files.
        # Process each operation separately and close immediately.
        
        mean_unc <- tryCatch({
          terra::app(unc_stack, fun = mean, na.rm = TRUE)
        }, error = function(e) NULL)
        
        median_unc <- tryCatch({
          terra::app(unc_stack, fun = median, na.rm = TRUE)
        }, error = function(e) NULL)
        
        sd_unc <- tryCatch({
          terra::app(unc_stack, fun = sd, na.rm = TRUE)
        }, error = function(e) NULL)
        
        if (!is.null(mean_unc) && !is.null(median_unc) && !is.null(sd_unc)) {
          
          mean_vals <- terra::values(mean_unc, na.rm = TRUE)
          median_vals <- terra::values(median_unc, na.rm = TRUE)
          sd_vals <- terra::values(sd_unc, na.rm = TRUE)
          
          msg("")
          msg("\nENSEMBLE UNCERTAINTY RESULTS")
          msg(" Mean Uncertainty (across", length(uncertainty_rasters), "algorithms):")
          msg(" Min:", round(min(mean_vals, na.rm = TRUE), 6))
          msg(" Mean:", round(mean(mean_vals, na.rm = TRUE), 6))
          msg(" Median:", round(median(mean_vals, na.rm = TRUE), 6))
          msg(" Max:", round(max(mean_vals, na.rm = TRUE), 6))
          msg(" SD:", round(sd(mean_vals, na.rm = TRUE), 6))
          
          msg("")
          msg(" Median Uncertainty (across", length(uncertainty_rasters), "algorithms):")
          msg(" Min:", round(min(median_vals, na.rm = TRUE), 6))
          msg(" Mean:", round(mean(median_vals, na.rm = TRUE), 6))
          msg(" Median:", round(median(median_vals, na.rm = TRUE), 6))
          msg(" Max:", round(max(median_vals, na.rm = TRUE), 6))
          msg(" SD:", round(sd(median_vals, na.rm = TRUE), 6))
          
          msg("")
          msg(" Model Agreement (SD across algorithms):")
          msg(" Min:", round(min(sd_vals, na.rm = TRUE), 6))
          msg(" Mean:", round(mean(sd_vals, na.rm = TRUE), 6))
          msg(" Median:", round(median(sd_vals, na.rm = TRUE), 6))
          msg(" Max:", round(max(sd_vals, na.rm = TRUE), 6))
          
          # FIX #7: Write and close rasters immediately
          # WHY: writeRaster creates temp files during write. Without explicit close(),
          # these persist. Write one, close it, move to next.
          
          tryCatch({
            terra::writeRaster(mean_unc, 
                        filename = file.path(uncertainty_dir, paste0(sp, "_ensemble_uncertainty_mean.tif")), 
                        overwrite = TRUE,
                        wopt = list(gdal = c("COMPRESS=LZW")))
            close_raster_safely(mean_unc)
          }, error = function(e) msg("  [WARNING] Failed to write mean uncertainty"))
          
          tryCatch({
            terra::writeRaster(median_unc, 
                        filename = file.path(uncertainty_dir, paste0(sp, "_ensemble_uncertainty_median.tif")), 
                        overwrite = TRUE,
                        wopt = list(gdal = c("COMPRESS=LZW")))
            close_raster_safely(median_unc)
          }, error = function(e) msg("  [WARNING] Failed to write median uncertainty"))
          
          tryCatch({
            terra::writeRaster(sd_unc, 
                        filename = file.path(uncertainty_dir, paste0(sp, "_model_agreement_sd.tif")), 
                        overwrite = TRUE,
                        wopt = list(gdal = c("COMPRESS=LZW")))
            close_raster_safely(sd_unc)
          }, error = function(e) msg("  [WARNING] Failed to write SD uncertainty"))
          
          msg("Saved uncertainty rasters (mean, median, and SD) ✓")
          
          results <- data.frame(
            Model = character(),
            Uncertainty_Mean = numeric(),
            Uncertainty_Median = numeric(),
            Uncertainty_SD = numeric(),
            Uncertainty_Min = numeric(),
            Uncertainty_Max = numeric(),
            stringsAsFactors = FALSE
          )
          
          for(model_name in names(uncertainty_rasters)) {
            vals <- terra::values(uncertainty_rasters[[model_name]], na.rm = TRUE)
            results <- rbind(results, data.frame(
              Model = model_name,
              Uncertainty_Mean = mean(vals, na.rm = TRUE),
              Uncertainty_Median = median(vals, na.rm = TRUE),
              Uncertainty_SD = sd(vals, na.rm = TRUE),
              Uncertainty_Min = min(vals, na.rm = TRUE),
              Uncertainty_Max = max(vals, na.rm = TRUE)
            ))
          }
          
          results <- results[order(results$Uncertainty_Mean), ]
          
          write.csv(results, file.path(uncertainty_dir, paste0(sp, "_individual_uncertainty.csv")), 
                    row.names = FALSE)
          msg("Saved individual model uncertainty statistics ✓")
          
          msg("")
          msg("Best Model (lowest mean uncertainty):", results$Model[1], 
              "| Mean:", round(results$Uncertainty_Mean[1], 6))
          msg("Best Model (lowest median uncertainty):", results$Model[which.min(results$Uncertainty_Median)], 
              "| Median:", round(min(results$Uncertainty_Median), 6))
          
          # Create uncertainty plots with explicit device closure
          names(mean_unc) <- "mean_uncertainty"
          names(median_unc) <- "median_uncertainty"
          names(sd_unc) <- "agreement"
          
          p1 <- ggplot() +
            tidyterra::geom_spatraster(data = mean_unc) +
            scale_fill_viridis_c(name = "Uncertainty\n(mean)", direction = 1, option = "inferno", na.value = "transparent") +
            coord_sf(crs = terra::crs(mean_unc)) +
            theme_bw() +
            labs(title = bquote("Ensemble Uncertainty -" ~ italic(.(sp_display))),
                 subtitle = paste("Based on", length(uncertainty_rasters),"models | 250 iterations"),
                 x = "Longitude", y = "Latitude") +
            theme(plot.title = element_text(hjust = 0.5, size = 12),
                  plot.subtitle = element_text(hjust = 0.5, size = 10),
                  legend.position = "right")
          
          safe_ggsave_with_devoff(
            file.path(uncertainty_dir, paste0(sp, "_1_ensemble_mean_uncertainty_map.png")),
            p1, width = 10, height = 8, dpi = 500
          )
          msg("Saved ensemble mean uncertainty map ✓")
          
          p2 <- ggplot() +
            tidyterra::geom_spatraster(data = median_unc) +
            scale_fill_viridis_c(name = "Uncertainty\n(median)", direction = 1, option = "plasma", na.value = "transparent") +
            coord_sf(crs = terra::crs(median_unc)) +
            theme_bw() +
            labs(title = bquote("Ensemble Uncertainty -" ~ italic(.(sp_display))),
                 subtitle = paste("Based on", length(uncertainty_rasters),"models | 250 iterations"),
                 x = "Longitude", y = "Latitude") +
            theme(plot.title = element_text(hjust = 0.5, size = 12),
                  plot.subtitle = element_text(hjust = 0.5, size = 10),
                  legend.position = "right")
          
          safe_ggsave_with_devoff(
            file.path(uncertainty_dir, paste0(sp, "_2_ensemble_median_uncertainty_map.png")),
            p2, width = 10, height = 8, dpi = 500
          )
          msg("Saved ensemble median uncertainty map ✓")
          
          p3 <- ggplot() +
            tidyterra::geom_spatraster(data = sd_unc) +
            scale_fill_viridis_c(name = "Agreement\n(SD)", direction = 1, option = "viridis", na.value = "transparent") +
            coord_sf(crs = terra::crs(sd_unc)) +
            theme_bw() +
            labs(title = bquote("Model Agreement -" ~ italic(.(sp_display))),
                 subtitle = "Lower SD indicates better agreement between models",
                 x = "Longitude", y = "Latitude") +
            theme(plot.title = element_text(hjust = 0.5, size = 12),
                  plot.subtitle = element_text(hjust = 0.5, size = 10),
                  legend.position = "right")
          
          safe_ggsave_with_devoff(
            file.path(uncertainty_dir, paste0(sp, "_3_model_agreement_map.png")),
            p3, width = 10, height = 8, dpi = 500
          )
          msg("Saved model agreement map ✓")
          
          mean_vals_hist <- terra::values(mean_unc, na.rm = TRUE)
          median_vals_hist <- terra::values(median_unc, na.rm = TRUE)
          
          hist_df <- data.frame(
            uncertainty = c(mean_vals_hist, median_vals_hist),
            type = rep(c("Mean", "Median"), each = length(mean_vals_hist))
          )
          hist_df <- hist_df[!is.na(hist_df$uncertainty), ]
          
          if(nrow(hist_df) > 0) {
            p4 <- ggplot(hist_df, aes(x = uncertainty, fill = type)) +
              geom_histogram(alpha = 0.7, bins = 30, position = "identity") +
              scale_fill_manual(values = c("Mean" = "steelblue", "Median" = "darkorange")) +
              theme_bw() +
              labs(title = bquote("Uncertainty Distribution -" ~ italic(.(sp_display))),
                   subtitle = paste(
                              "Mean uncertainty: mean =", round(mean(mean_vals_hist, na.rm = TRUE), 6),
                              ", median =", round(median(mean_vals_hist, na.rm = TRUE), 6),
                              " | Median uncertainty: mean =", round(mean(median_vals_hist, na.rm = TRUE), 6),
                              ", median =", round(median(median_vals_hist, na.rm = TRUE), 6)),
                   x = "Uncertainty Value", y = "Frequency") +
              theme(plot.title = element_text(hjust = 0.5, size = 12),
                    plot.subtitle = element_text(hjust = 0.5, size = 9),
                    legend.position = "right")
            
            safe_ggsave_with_devoff(
              file.path(uncertainty_dir, paste0(sp, "_4_uncertainty_histogram_comparison.png")),
              p4, width = 10, height = 6, dpi = 500
            )
            msg("Saved uncertainty histogram comparison ✓")
          }
          
          uncertainty_result <- list(
            uncertainty_rasters = uncertainty_rasters,
            mean_unc = mean_unc,
            median_unc = median_unc,
            sd_unc = sd_unc,
            individual_stats = results
          )
          
          msg("Uncertainty analysis complete ✓")
        }
        
        # FIX #8: Close uncertainty rasters before cleanup
        # WHY: uncertainty_rasters list holds SpatRaster references that block
        # temp file deletion and file descriptor release
        for (ur in uncertainty_rasters) {
          close_raster_safely(ur)
        }
        close_raster_safely(unc_stack)
        rm(uncertainty_rasters, unc_stack, mean_unc, median_unc, sd_unc)
        
      } else {
        msg("Not enough models with uncertainty results (need at least 2)")
      }
    } else {
      msg("Not enough models for uncertainty analysis (need at least 2)")
    }
    
    # ========== PDP PLOTS WITH UNCERTAINTY ==========
    msg("\nGenerating PDP plots with uncertainty (DPI= 500 )...")
    
    pdp_success <- FALSE
    if (length(successful_models) >= 2) {
      msg("    Generating PDPs with uncertainty for", length(successful_models), "models...")
      
      pdp_list <- list()
      for(model_name in names(successful_models)) {
        msg("      Processing", model_name, "...")
        pdp_results <- list()
        
        model_obj <- successful_models[[model_name]]
        if(inherits(model_obj, "train")) {
          model <- model_obj
        } else if(inherits(model_obj, "sdm_model") && !is.null(model_obj$model)) {
          model <- model_obj$model
        } else if(is.list(model_obj) && !is.null(model_obj$model)) {
          model <- model_obj$model
        } else {
          model <- model_obj
        }
        
        for(p in var_names) {
          tryCatch({
            if(!is.null(model)) {
              pdp_output <- flexsdm::data_pdp(
                model = model,
                predictors = p,
                resolution = 100,
                resid = TRUE,
                projection_data = env_r,
                training_data = pa,
                clamping = FALSE
              )
              
              if(!is.null(pdp_output) && !is.null(pdp_output$pdpdata)) {
                df <- pdp_output$pdpdata
                df$Predictor <- p
                df$Value <- df[[p]]
                df[[p]] <- NULL
                df$Algorithm <- model_name
                pdp_results[[p]] <- df
              }
            }
          }, error = function(e) {
            msg("      Warning: Could not generate PDP for", model_name, "-", p)
          })
        }
        
        pdp_results <- pdp_results[!sapply(pdp_results, is.null)]
        if(length(pdp_results) > 0) {
          pdp_list[[model_name]] <- dplyr::bind_rows(pdp_results)
        }
      }
      
      if(length(pdp_list) > 0) {
        msg("Successfully generated PDP for", length(pdp_list), "models ✓")
        
        db_all <- dplyr::bind_rows(pdp_list)
        
        db_wide <- db_all %>%
          dplyr::select(Predictor, Value, Algorithm, Suitability) %>%
          tidyr::pivot_wider(names_from = Algorithm, values_from = Suitability)
        
        algo_cols <- names(db_wide)[names(db_wide) %in% names(successful_models)]
        
        db_wide <- db_wide %>%
          dplyr::mutate(
            Ensemble_Mean = rowMeans(dplyr::select(., dplyr::all_of(algo_cols)), na.rm = TRUE),
            Ensemble_Median = apply(dplyr::select(., dplyr::all_of(algo_cols)), 1, median, na.rm = TRUE),
            SD = apply(dplyr::select(., dplyr::all_of(algo_cols)), 1, sd, na.rm = TRUE),
            ymin = pmax(0, Ensemble_Mean - SD),
            ymax = pmin(1, Ensemble_Mean + SD)
          )
        
        db_long_mean <- db_wide %>%
          tidyr::pivot_longer(
            cols = dplyr::all_of(c(algo_cols, "Ensemble_Mean")),
            names_to = "Algorithm",
            values_to = "Suitability"
          )
        
        db_median <- db_wide %>%
          dplyr::select(Predictor, Value, Ensemble_Median) %>%
          dplyr::mutate(Algorithm = "Ensemble_Median")
        
        n_models <- length(algo_cols)
        color_values <- c(
          setNames(grDevices::rainbow(n_models), algo_cols),
          Ensemble_Mean = "black",
          Ensemble_Median = "steelblue"
        )
        linetype_values <- c(
          setNames(rep("dotted", n_models), algo_cols),
          Ensemble_Mean = "solid",
          Ensemble_Median = "dashed"
        )
        
        pdp_plot <- ggplot() +
          geom_ribbon(
            data = db_wide,
            aes(x = Value, ymin = ymin, ymax = ymax),
            fill = "grey70",
            alpha = 0.4
          ) +
          geom_line(
            data = db_long_mean %>% dplyr::filter(Algorithm != "Ensemble_Mean"),
            aes(x = Value, y = Suitability, color = Algorithm, linetype = Algorithm),
            linewidth = 0.8,
            alpha = 0.7
          ) +
          geom_line(
            data = db_long_mean %>% dplyr::filter(Algorithm == "Ensemble_Mean"),
            aes(x = Value, y = Suitability),
            color = "black",
            linewidth = 1.2,
            linetype = "solid"
          ) +
          geom_line(
            data = db_median,
            aes(x = Value, y = Ensemble_Median),
            color = "blue",
            linewidth = 1.2,
            linetype = "dashed"
          ) +
          facet_wrap(~Predictor, scales = "free_x", ncol = 2) +
          coord_cartesian(ylim = c(0, 1)) +
          scale_linetype_manual(values = linetype_values) +
          scale_color_manual(values = color_values) +
          labs(
            title = bquote(italic(.(sp_display)) ~ "- Partial Dependency Plot"),
            subtitle = paste(
              "Ensemble Mean (solid black) and Median (dashed blue) with ±1 SD ribbon | Based on",
              length(successful_models), "models"
            ),
            x = "Environmental Gradient",
            y = "Suitability"
          ) +
          theme_bw() +
          theme(
            panel.grid = element_blank(),
            legend.position = "right",
            plot.title = element_text(hjust = 0.5, size = 14),
            plot.subtitle = element_text(hjust = 0.5, size = 11),
            strip.text = element_text(face = "bold", size = 10),
            legend.text = element_text(size = 8),
            legend.title = element_blank()
          )
        
        out_png <- file.path(pdp_plots_dir, paste0(sp, "_pdp_ensemble_ribbon.png"))
        out_data <- file.path(pdp_plots_dir, paste0(sp, "_pdp_data.csv"))
        
        tryCatch({
          safe_ggsave_with_devoff(out_png, pdp_plot, width = 28, height = 20, dpi = 500)
          msg("Saved PDP plot with uncertainty ✓")
          
          write.csv(db_wide, out_data, row.names = FALSE)
          msg("Saved PDP data ✓")
          pdp_success <- TRUE
        }, error = function(e) {
          msg("Error saving PDP outputs:", e$message)
        })
      } else {
        msg("No PDP data generated")
      }
    }
    
    if (!pdp_success) {
      msg("Generating individual PDP plots (ensemble not possible)...")
      for (alg in names(successful_models)) {
        model_obj <- successful_models[[alg]]
        if(inherits(model_obj, "train")) {
          model <- model_obj
        } else if(inherits(model_obj, "sdm_model") && !is.null(model_obj$model)) {
          model <- model_obj$model
        } else if(is.list(model_obj) && !is.null(model_obj$model)) {
          model <- model_obj$model
        } else {
          model <- model_obj
        }
        
        if(!is.null(model)) {
          tryCatch({
            p_pdp <- flexsdm::data_pdp(
              model = model,
              predictors = var_names,
              resolution = 100,
              resid = TRUE,
              projection_data = env_r,
              training_data = pa,
              clamping = FALSE
            )
            
            if(!is.null(p_pdp) && !is.null(p_pdp$pdpdata)) {
              p <- ggplot(p_pdp$pdpdata, aes_string(x = var_names[1], y = "Suitability")) +
                geom_line(color = "red", linewidth = 1) + theme_bw() +
                labs(title = bquote(italic(.(sp_display)) ~ "-" ~ .(toupper(alg))),
                     x = var_names[1], y = "Suitability") +
                theme(plot.title = element_text(hjust = 0.5))
              
              safe_ggsave_with_devoff(
                file.path(pdp_plots_dir, paste0(sp, "_", alg, "_pdp.png")),
                p, width = 20, height = 15, dpi = 500
              )
            }
          }, error = function(e) invisible(NULL))
        }
      }
    }
    
    # ========== HYPERPARAMETER PLOTS ==========
    msg("\nHyperparameter plots...")
    
    if (!is.null(m_gbm) && !is.null(m_gbm$hyper_performance) && nrow(m_gbm$hyper_performance) > 0) {
      h <- m_gbm$hyper_performance
      for (metric in c("AUC_mean", "TSS_mean")) {
        p <- tryCatch({
          ggplot2::ggplot(h, ggplot2::aes_string(x = "n.trees", y = metric, col = "as.factor(n.minobsinnode)")) +
            ggplot2::geom_line() + ggplot2::facet_wrap(~shrinkage) + ggplot2::theme_bw() +
            ggplot2::ggtitle(bquote(italic(.(sp_display)) ~ "(GBM)")) +
            ggplot2::theme(plot.title = ggplot2::element_text(hjust = 0.5, size = 12), legend.position = "right")
        }, error = function(e) NULL)
        if (!is.null(p)) {
          safe_ggsave_with_devoff(
            file.path(hypplot_cur, paste0(sp, "_hyp_gbm_", if(metric == "AUC_mean") "auc" else "tss", ".png")),
            p, width = 14, height = 10, dpi = 500
          )
        }
      }
      readr::write_tsv(h, file.path(hypplot_cur, paste0(sp, "_hyp_gbm.txt")))
    }
    
    if (!is.null(m_max) && !is.null(m_max$hyper_performance) && nrow(m_max$hyper_performance) > 0) {
      h <- m_max$hyper_performance
      for (metric in c("AUC_mean", "TSS_mean")) {
        p <- tryCatch({
          ggplot2::ggplot(h, ggplot2::aes_string(x = "regmult", y = metric, col = "as.factor(classes)")) +
            ggplot2::geom_line() + ggplot2::theme_bw() +
            ggplot2::ggtitle(bquote(italic(.(sp_display)) ~ "(MAX)")) +
            ggplot2::theme(plot.title = ggplot2::element_text(hjust = 0.5, size = 12), legend.position = "right")
        }, error = function(e) NULL)
        if (!is.null(p)) {
          safe_ggsave_with_devoff(
            file.path(hypplot_cur, paste0(sp, "_hyp_max_", if(metric == "AUC_mean") "auc" else "tss", ".png")),
            p, width = 12, height = 8, dpi = 500
          )
        }
      }
      readr::write_tsv(h, file.path(hypplot_cur, paste0(sp, "_hyp_max.txt")))
    }
    
    if (!is.null(m_net) && !is.null(m_net$hyper_performance) && nrow(m_net$hyper_performance) > 0) {
      h <- m_net$hyper_performance
      for (metric in c("AUC_mean", "TSS_mean")) {
        p <- tryCatch({
          ggplot2::ggplot(h, ggplot2::aes_string(x = "decay", y = metric, col = "as.factor(size)")) +
            ggplot2::geom_line() + ggplot2::theme_bw() +
            ggplot2::ggtitle(bquote(italic(.(sp_display)) ~ "(NET)")) +
            ggplot2::theme(plot.title = ggplot2::element_text(hjust = 0.5, size = 12), legend.position = "right")
        }, error = function(e) NULL)
        if (!is.null(p)) {
          safe_ggsave_with_devoff(
            file.path(hypplot_cur, paste0(sp, "_hyp_net_", if(metric == "AUC_mean") "auc" else "tss", ".png")),
            p, width = 12, height = 8, dpi = 500
          )
        }
      }
      readr::write_tsv(h, file.path(hypplot_cur, paste0(sp, "_hyp_net.txt")))
    }
    
    if (!is.null(m_raf) && !is.null(m_raf$hyper_performance) && nrow(m_raf$hyper_performance) > 0) {
      h <- m_raf$hyper_performance
      for (metric in c("AUC_mean", "TSS_mean")) {
        p <- tryCatch({
          ggplot2::ggplot(h, ggplot2::aes_string(x = "mtry", y = metric)) +
            ggplot2::geom_line() + ggplot2::theme_bw() +
