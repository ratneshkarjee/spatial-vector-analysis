create_header <- function(sp, i, total) {
  header_text <- paste0("SPECIES:  ", sp, "  [ ", i, " / ", total, " ]")
  header_width <- nchar(header_text)
  line <- strrep("=", header_width)
  list(line = line, text = header_text)
}

print_header <- function(header_obj) {
  msg(header_obj$line)
  msg(header_obj$text)
  msg(header_obj$line)
}

# FIX #3: Explicit raster closure function
# WHY: terra rasters hold GDAL dataset handles. Without explicit terra::close(),
# handles remain open until garbage collection, accumulating across species.
close_raster_safely <- function(rast_obj) {
  if (!is.null(rast_obj) && inherits(rast_obj, "SpatRaster")) {
    tryCatch({
      terra::close(rast_obj)
    }, error = function(e) invisible(NULL))
  }
  invisible(NULL)
}

# FIX #4: Safe graphics device closure after ggsave
# WHY: Each ggsave() opens a graphics device. Without explicit dev.off(),
# devices accumulate in R's internal state → file descriptor exhaustion
safe_ggsave_with_devoff <- function(filename, plot, width, height, dpi) {
  tryCatch({
    ggplot2::ggsave(
      filename = filename, plot = plot,
      width = width, height = height, dpi = dpi, bg = "white"
    )
    grDevices::dev.off()  # CRITICAL: Always close the device
    invisible(TRUE)
  }, error = function(e) {
    tryCatch(grDevices::dev.off(), error = function(e2) invisible(NULL))
    msg("  [WARNING] ggsave failed:", basename(filename), ":", e$message)
    invisible(FALSE)
  })
}

# FIX #5: Cleanup function between species
# WHY: terra::app() creates intermediate temp layers in temp_dir. Without explicit
# removal + gc(), temp files accumulate. After each species, we must:
# 1. Remove old terra temp files (terra::tmpFiles removes unneeded temp data)
# 2. Run garbage collection (gc) to finalize object destruction
# 3. Small delay allows OS to release file handles
cleanup_after_species <- function() {
  tryCatch({
    terra::tmpFiles(remove = TRUE, old = TRUE)
  }, error = function(e) invisible(NULL))
  
  gc(verbose = FALSE, reset = TRUE)
  Sys.sleep(0.15)  # Allow OS to release handles
  invisible(NULL)
}

